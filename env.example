# Copy to .env.local (gitignored). reeval reads it next to reeval.config.ts.
# Harness keys: one per agent you run. The agent never sees the real value; reeval's gateway brokers it.
ANTHROPIC_API_KEY=
CURSOR_API_KEY=
OPENAI_API_KEY=
# Gemini: the Antigravity harness, and the Genkit app under test (brokered into the sandbox as GEMINI_API_KEY).
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
