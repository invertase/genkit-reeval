   name: 'triage',
   system: 'Delegate order questions to orderAgent and refund requests to refundAgent. Do not answer them yourself.',
   maxTurns: 5,
+  store,
   toolChoice: 'auto',
   use: [agents({ agents: ['orderAgent', 'refundAgent'], maxDelegations: 3, historyLength: 4 })],
 });
