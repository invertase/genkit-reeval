diff --git a/answer.json b/answer.json
new file mode 100644
index 0000000..e378f2c
--- /dev/null
+++ b/answer.json
@@ -0,0 +1,6 @@
+{
+  "file": "src/agents.ts",
+  "snippet": "toolChoice: 'required',",
+  "cause": "The refundAgent is configured with toolChoice 'required', which forces Gemini to emit a function call on every turn, so after approveRefund returns approved: false the model cannot produce the final text reply and keeps calling tools (approveRefund, lookupOrder) until maxTurns is exhausted.",
+  "evidence": "Before the fix, a scratch script (outside the project) sent the A-1001 refund request, got an approveRefund interrupt, resumed with approved: false, and the call threw 'ABORTED: Exceeded maximum tool call iterations (6)'. toolChoice 'required' maps to Gemini mode ANY in node_modules/@genkit-ai/google-genai/src/common/converters.ts. After changing it to 'auto' (the same setting triage uses), two runs of the same scenario returned a customer reply: 'The refund for order A-1001 was not approved because it is a duplicate claim.'"
+}
diff --git a/src/agents.ts b/src/agents.ts
index 7283e38..34e0ee7 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -40,7 +40,7 @@ export const refundAgent = ai.defineAgent({
   description: 'Handles refund requests for an order. Refunds need human approval.',
   system: 'Look up the order, then call approveRefund, then issueRefund only if approved. Never refund without approval.',
   tools: [lookupOrder, approveRefund, issueRefund],
-  toolChoice: 'required',
+  toolChoice: 'auto',
   maxTurns: 6,
   store,
 });
