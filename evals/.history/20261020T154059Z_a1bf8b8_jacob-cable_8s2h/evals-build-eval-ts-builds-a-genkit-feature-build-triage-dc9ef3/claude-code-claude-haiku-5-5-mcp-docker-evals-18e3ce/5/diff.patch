+
+const askOrderDesk = ai.defineTool(
+  {
+    name: 'askOrderDesk',
+    description: 'Passes an order question (status, delivery, tracking, total) to the order desk and returns its answer.',
+    inputSchema: z.object({ request: z.string().describe('The customer question, including the order id') }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundDesk = ai.defineTool(
+  {
+    name: 'askRefundDesk',
+    description: 'Passes a refund request to the refund desk and returns its reply.',
+    inputSchema: z.object({ request: z.string().describe('The refund request, including the order id and reason') }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await refundAgent.chat().send(request)).text,
+);
+
+/** Front desk: the first agent a customer talks to. Hands order and refund work to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies customers. Hands order questions and refund requests to specialists.',
+  system:
+    'You are the Northwind Supplies front desk. For any question about an order, call askOrderDesk. ' +
+    'For any refund request, call askRefundDesk. Never answer order or refund questions yourself. ' +
+    'Pass the order id and the customer details to the desk, using the conversation so far when the customer does not repeat them. ' +
+    'Relay the desk reply to the customer. Keep replies short.',
+  tools: [askOrderDesk, askRefundDesk],
+  maxTurns: 4,
+  store,
+});
