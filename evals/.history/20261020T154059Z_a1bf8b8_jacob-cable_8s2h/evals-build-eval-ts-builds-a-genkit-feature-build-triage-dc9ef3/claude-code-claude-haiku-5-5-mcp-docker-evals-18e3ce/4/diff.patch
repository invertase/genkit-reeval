diff --git a/src/agents.ts b/src/agents.ts
index 8bde8a3..40eef2d 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -43,3 +43,43 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description: 'Hands an order question to the order desk. Put the order id, for example A-1001, in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description: 'Hands a refund request to the refund desk. Put the order id and the amount in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    return response.interrupts.length > 0
+      ? 'The refund is waiting for human approval and has not been issued.'
+      : response.text;
+  },
+);
+
+/** Customers' first contact. Hands order questions and refund requests to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Routes order questions and refund requests to specialist agents.',
+  system:
+    'You are the front desk for Northwind Supplies. Greet customers and answer general questions briefly yourself. ' +
+    'For order questions (status, delivery, tracking, total), call askOrderAgent. For refund requests, call askRefundAgent. ' +
+    'Never answer order or refund questions yourself. Each tool call starts a fresh conversation with the specialist, ' +
+    'so include the order id and every detail the specialist needs in the request. ' +
+    'Remember order ids the customer gave earlier in this conversation.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
