diff --git a/src/agents.ts b/src/agents.ts
index 8bde8a3..ecf5eb7 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -43,3 +43,42 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description: 'Passes an order question to the order desk and returns its answer. Include the order id in the message.',
+    inputSchema: z.object({ message: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => (await orderAgent.chat().send(message)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description:
+      'Passes a refund request to the refund desk and returns its reply. Include the order id and the reason in the message.',
+    inputSchema: z.object({ message: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => {
+    const response = await refundAgent.chat().send(message);
+    if (response.interrupts.length === 0) return response.text;
+    return `${response.text} The refund is waiting for approval in refund session ${response.sessionId}.`;
+  },
+);
+
+/** Front desk: the first contact for customers. Hands order and refund requests to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Hands order questions to the order desk and refund requests to the refund desk.',
+  system:
+    'You are the Northwind Supplies front desk, the first contact for customers. ' +
+    'Pass order questions to askOrderAgent and refund requests to askRefundAgent; do not answer them yourself. ' +
+    "Include the customer's order id in what you pass on. Keep replies short. " +
+    'Use what the customer told you earlier in the conversation, such as their name or order id.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
