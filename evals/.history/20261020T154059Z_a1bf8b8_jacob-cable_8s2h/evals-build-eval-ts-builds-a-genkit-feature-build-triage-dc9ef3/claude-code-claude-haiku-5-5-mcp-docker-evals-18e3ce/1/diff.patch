diff --git a/src/agents.ts b/src/agents.ts
index 8bde8a3..203ea0c 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -43,3 +43,41 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description: 'Hands an order question to the order desk and returns its answer. Include the order id in the request.',
+    inputSchema: z.object({ request: z.string().describe('The customer question, with the order id') }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description: 'Hands a refund request to the refund desk and returns its answer. Include the order id and the reason in the request.',
+    inputSchema: z.object({ request: z.string().describe('The refund request, with the order id and reason') }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    return response.interrupts.length > 0 ? 'The refund is waiting for human approval.' : response.text;
+  },
+);
+
+/** Front desk the customer talks to first; hands order and refund questions to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for customers. Routes order questions and refund requests to the specialist agents.',
+  system:
+    'You are the Northwind Supplies front desk. Customers talk to you first. ' +
+    'For questions about an order, such as its status, delivery, tracking or total, call askOrderAgent. ' +
+    'For refund requests, call askRefundAgent. Never answer order or refund questions yourself. ' +
+    'When the customer refers to an order from earlier in the conversation, such as "its", include that order id in the request. ' +
+    'Relay the specialist answer to the customer. Answer any other question briefly yourself.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
