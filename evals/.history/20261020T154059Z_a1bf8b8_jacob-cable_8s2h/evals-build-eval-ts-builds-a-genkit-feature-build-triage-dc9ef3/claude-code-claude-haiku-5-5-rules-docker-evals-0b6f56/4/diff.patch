diff --git a/src/agents.ts b/src/agents.ts
index 8bde8a3..3c2a6c8 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -43,3 +43,43 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderDesk = ai.defineTool(
+  {
+    name: 'askOrderDesk',
+    description:
+      'Passes an order question (status, delivery date, tracking code, total) to the order desk and returns its answer. ' +
+      'The order desk cannot see the conversation, so include the order id and every detail it needs.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundDesk = ai.defineTool(
+  {
+    name: 'askRefundDesk',
+    description:
+      'Passes a refund request to the refund desk and returns its reply. ' +
+      'The refund desk cannot see the conversation, so include the order id, amount and reason.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    return response.interrupts.length > 0 ? 'The refund is waiting for human approval.' : response.text;
+  },
+);
+
+/** First point of contact for customers. Routes order and refund questions to the desks instead of answering them. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for customers. Routes order questions and refund requests to the right desk.',
+  system:
+    'You are the Northwind Supplies front desk. Do not answer order or refund questions yourself. ' +
+    'Send order questions to askOrderDesk and refund requests to askRefundDesk, then tell the customer their reply. ' +
+    'Both desks start with no memory of this conversation, so put any order id the customer gave you into each request.',
+  tools: [askOrderDesk, askRefundDesk],
+  maxTurns: 4,
+  store,
+});
