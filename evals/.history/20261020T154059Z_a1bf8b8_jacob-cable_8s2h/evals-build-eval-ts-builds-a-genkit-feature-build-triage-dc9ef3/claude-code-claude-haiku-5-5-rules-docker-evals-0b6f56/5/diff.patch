diff --git a/src/agents.ts b/src/agents.ts
index 8bde8a3..97cf734 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -43,3 +43,42 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description:
+      'Hands an order question to the order desk: status, delivery date, tracking code or total. Include the order id in the request.',
+    inputSchema: z.object({ request: z.string().describe('The customer question with its order id, for example A-1001') }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description: 'Hands a refund request to the refund desk. Include the order id and the reason in the request.',
+    inputSchema: z.object({ request: z.string().describe('The refund request with its order id and reason') }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.interrupts.length > 0) return 'The refund is waiting for human approval and has not been issued.';
+    return response.text;
+  },
+);
+
+/** Front desk the customer talks to first; hands order and refund requests to specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies customers. Hands order and refund questions to specialist agents.',
+  system:
+    'You are the Northwind Supplies front desk. Answer greetings and general questions briefly yourself. ' +
+    'For questions about an order (status, delivery, tracking, total) call askOrderAgent. ' +
+    'For refund requests call askRefundAgent. Never answer order or refund questions yourself. ' +
+    'Include the order id and the customer question in the request, using order ids the customer gave earlier in this conversation.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
