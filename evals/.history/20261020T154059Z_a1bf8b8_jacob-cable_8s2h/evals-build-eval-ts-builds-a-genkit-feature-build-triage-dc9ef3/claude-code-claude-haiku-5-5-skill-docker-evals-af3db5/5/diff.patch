@@ -43,3 +43,40 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const handOffToOrderAgent = ai.defineTool(
+  {
+    name: 'handOffToOrderAgent',
+    description: 'Passes an order question (status, delivery, tracking, total) to the order desk and returns its reply.',
+    inputSchema: z.object({
+      message: z.string().describe('A self-contained question that includes the order id'),
+    }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => (await orderAgent.chat().send(message)).text,
+);
+
+const handOffToRefundAgent = ai.defineTool(
+  {
+    name: 'handOffToRefundAgent',
+    description: 'Passes a refund request to the refund desk and returns its reply. Refunds need human approval.',
+    inputSchema: z.object({
+      message: z.string().describe('A self-contained refund request that includes the order id'),
+    }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => (await refundAgent.chat().send(message)).text,
+);
+
+/** The front desk: the first agent a customer talks to. Hands order and refund requests to specialists. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Hands order questions to orderAgent and refund requests to refundAgent.',
+  system:
+    'You are the front desk of the Northwind Supplies support team. Greet the customer and find out what they need. ' +
+    'Do not answer questions about orders or refunds yourself. Hand order questions to handOffToOrderAgent and refund requests to handOffToRefundAgent. ' +
+    'Write each hand-off as a complete message that includes the order id from earlier in the conversation, and relay the reply to the customer.',
+  tools: [handOffToOrderAgent, handOffToRefundAgent],
+  maxTurns: 4,
+  store,
+});
