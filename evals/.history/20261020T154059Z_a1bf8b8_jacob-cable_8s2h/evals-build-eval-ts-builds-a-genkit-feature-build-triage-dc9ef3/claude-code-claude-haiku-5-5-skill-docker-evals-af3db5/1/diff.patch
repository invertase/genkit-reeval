diff --git a/src/agents.ts b/src/agents.ts
index 8bde8a3..c31148c 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -43,3 +43,44 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const handOffToOrderAgent = ai.defineTool(
+  {
+    name: 'handOffToOrderAgent',
+    description:
+      'Hands an order question (status, delivery date, tracking code, total) to the order desk. ' +
+      'Put the order id in the message. Returns the order desk reply.',
+    inputSchema: z.object({ message: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => (await orderAgent.chat().send(message)).text,
+);
+
+const handOffToRefundAgent = ai.defineTool(
+  {
+    name: 'handOffToRefundAgent',
+    description:
+      'Hands a refund request to the refund desk. Put the order id and the reason in the message. ' +
+      'Returns the refund desk reply.',
+    inputSchema: z.object({ message: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => {
+    const response = await refundAgent.chat().send(message);
+    return response.interrupts.length > 0 ? 'The refund is waiting for human approval.' : response.text;
+  },
+);
+
+/** Front desk agent that customers talk to first; hands order and refund questions to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Greets the customer and routes order questions and refund requests to the right desk.',
+  system:
+    'You are the Northwind Supplies front desk. Find out what the customer needs. ' +
+    'For order status, delivery, tracking or total questions, call handOffToOrderAgent. ' +
+    'For refund requests, call handOffToRefundAgent. Never answer order or refund questions yourself. ' +
+    'Keep replies to one or two sentences. Use what the customer told you earlier in the conversation, such as their name or order id, and include the order id when you hand off.',
+  tools: [handOffToOrderAgent, handOffToRefundAgent],
+  maxTurns: 4,
+  store,
+});
