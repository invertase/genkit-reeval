diff --git a/src/agents.ts b/src/agents.ts
index 8bde8a3..db492e8 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -43,3 +43,43 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description:
+      'Hands an order question to the order desk and returns its answer. Include the order id in the question, for example "What is the status of order A-1001?"',
+    inputSchema: z.object({ question: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ question }) => (await orderAgent.chat().send(question)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description:
+      'Hands a refund request to the refund desk and returns its reply. Include the order id and the reason in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    return response.interrupts.length > 0 ? 'The refund is waiting for human approval and has not been issued.' : response.text;
+  },
+);
+
+/** Front desk agent: answers general questions and routes order and refund requests to specialists. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Routes order and refund requests to specialists and keeps the conversation going.',
+  system:
+    'You are the Northwind Supplies front desk. Greet customers and answer general questions briefly yourself. ' +
+    'For questions about an order, call askOrderAgent. For refund requests, call askRefundAgent. ' +
+    'Never answer order or refund questions yourself. ' +
+    'Include the order id and any other details the customer gave earlier in the conversation in the question or request you pass on. ' +
+    'Give the customer the specialist answer as it was returned.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
