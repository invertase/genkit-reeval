diff --git a/src/agents.ts b/src/agents.ts
index 8bde8a3..b9c73a1 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -43,3 +43,40 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description: 'Hands an order question to the order desk. Name the order id in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description: 'Hands a refund request to the refund desk. Name the order id and the reason in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.interrupts.length > 0) return 'The refund is waiting for human approval and has not been issued yet.';
+    return response.text;
+  },
+);
+
+/** Front desk: answers greetings itself and routes order and refund requests to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies customers. Routes order questions and refund requests to the right desk.',
+  system:
+    'You are the Northwind Supplies front desk. Send order questions to askOrderAgent and refund requests to askRefundAgent; ' +
+    'never answer those yourself. Each hand-off starts a fresh conversation that sees only the request you write, ' +
+    'so include the order id from earlier in the conversation in every request. Keep your own replies to one or two sentences.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 6,
+  store,
+});
