diff --git a/src/agents.ts b/src/agents.ts
index 8bde8a3..c57c255 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -43,3 +43,47 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderDesk = ai.defineTool(
+  {
+    name: 'askOrderDesk',
+    description:
+      'Sends an order question (status, delivery, tracking, total) to the order desk and returns its answer. ' +
+      'The order desk cannot see the conversation, so include the order id.',
+    inputSchema: z.object({ question: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ question }) => (await orderAgent.chat().send(question)).text,
+);
+
+const askRefundDesk = ai.defineTool(
+  {
+    name: 'askRefundDesk',
+    description:
+      'Sends a refund request to the refund desk and returns its answer. ' +
+      'The refund desk cannot see the conversation, so include the order id, amount and reason.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.interrupts.length === 0) return response.text;
+    const pending = response.interrupts.map((interrupt) => interrupt.input);
+    return `Refund is waiting for human approval in refund session ${response.sessionId}: ${JSON.stringify(pending)}`;
+  },
+);
+
+/** Front desk: the first agent customers talk to. Hands order and refund requests to the specialist desks. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies customers. Hands order questions and refund requests to the specialist desks.',
+  system:
+    'You are the Northwind Supplies front desk, the first point of contact for customers. ' +
+    'Do not answer order or refund questions yourself. For questions about an order, call askOrderDesk. ' +
+    'For refund requests, call askRefundDesk. The desks cannot see this conversation, so put the order id and every relevant detail the customer gave into the request. ' +
+    'Relay the desk answer to the customer and keep replies short. ' +
+    'Use what the customer told you earlier in the conversation, such as their name or order id.',
+  tools: [askOrderDesk, askRefundDesk],
+  maxTurns: 4,
+  store,
+});
