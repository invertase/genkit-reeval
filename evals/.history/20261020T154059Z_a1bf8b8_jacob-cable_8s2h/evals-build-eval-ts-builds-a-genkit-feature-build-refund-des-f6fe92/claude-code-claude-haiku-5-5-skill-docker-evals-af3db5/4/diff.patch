--- a/src/agents.ts
+++ b/src/agents.ts
@@ -0,0 +1,45 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description: 'Asks a human to approve refunding an order. Waits for the human before it returns.',
+  inputSchema: z.object({
+    orderId: z.string().describe('The order id, for example A-1001'),
+    amount: z.number().describe('The amount to refund'),
+    reason: z.string().describe('Why the customer wants a refund'),
+  }),
+  outputSchema: z.object({
+    approved: z.boolean(),
+    note: z.string().optional(),
+  }),
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description: 'Issues a refund for an order. Only call it after approveRefund returned approved: true.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('The amount to refund'),
+    }),
+    outputSchema: z.object({ refundId: z.string() }),
+  },
+  async ({ orderId, amount }) => ({ refundId: createRefund(orderId, amount) }),
+);
+
+/** Handles refund requests: looks up the order, waits for human approval, then issues the refund. */
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  description: 'Handles customer refund requests for Northwind Supplies, with human approval before any refund is issued.',
+  system:
+    'You are the refund desk of Northwind Supplies. Handle refund requests step by step:\n' +
+    '1. Look up the order the customer names with lookupOrder. If there is no such order, say so in one sentence and stop.\n' +
+    '2. If the order is not refundable, tell the customer it is not eligible for a refund and stop. Do not call approveRefund or issueRefund.\n' +
+    '3. Otherwise call approveRefund once, with the order id, the order total as the amount (unless the customer asks for less), and a short reason taken from the customer\'s request.\n' +
+    '4. Only if approveRefund returned approved: true, call issueRefund with the same order id and amount, then tell the customer in one or two sentences that the refund was issued and give the refund id. Never call issueRefund without an approved answer.\n' +
+    '5. If approveRefund returned approved: false, do not issue any refund. Tell the customer in one or two sentences that the refund was not approved, including the note if there is one.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
