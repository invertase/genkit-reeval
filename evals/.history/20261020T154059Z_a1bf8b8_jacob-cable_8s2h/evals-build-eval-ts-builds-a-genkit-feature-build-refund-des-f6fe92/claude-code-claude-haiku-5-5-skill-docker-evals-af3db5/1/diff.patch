diff --git a/src/agents.ts b/src/agents.ts
index e69de29..ac64f60 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -0,0 +1,47 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description: 'Asks a human to approve a refund. The conversation pauses until the human answers.',
+  inputSchema: z.object({
+    orderId: z.string().describe('The order id, for example A-1001'),
+    amount: z.number().describe('Refund amount, in the order currency'),
+    reason: z.string().describe('Why the customer wants the refund'),
+  }),
+  outputSchema: z.object({
+    approved: z.boolean(),
+    note: z.string().optional(),
+  }),
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description: 'Issues a refund for an order. Call only after approveRefund returned approved: true.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, exactly as lookupOrder reports it'),
+      amount: z.number().describe('Refund amount, in the order currency'),
+    }),
+    outputSchema: z.object({ refundId: z.string() }),
+  },
+  async ({ orderId, amount }) => ({ refundId: createRefund(orderId, amount) }),
+);
+
+/** Handles refund requests: checks the order, waits for a human to approve, then issues the refund. */
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  description: 'Handles refund requests for Northwind Supplies orders, with human approval before any refund is issued.',
+  system:
+    'You are the refund desk of Northwind Supplies. Work through a refund request in this order. ' +
+    '1. If the request does not name an order, ask for the order id. ' +
+    '2. Call lookupOrder. If there is no such order, or refundable is false, tell the customer in one or two sentences and stop. ' +
+    '3. Otherwise call approveRefund with the order id, the order total as the amount unless the customer asks for less, and the customer\'s reason. ' +
+    'A human decides before you continue. ' +
+    '4. If approved is true, call issueRefund with the same order id and amount, then tell the customer the refund is issued and give its refund id. ' +
+    '5. If approved is false, do not call issueRefund. Tell the customer in one or two sentences that the refund was not approved. ' +
+    'Never call issueRefund unless approveRefund returned approved: true.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
