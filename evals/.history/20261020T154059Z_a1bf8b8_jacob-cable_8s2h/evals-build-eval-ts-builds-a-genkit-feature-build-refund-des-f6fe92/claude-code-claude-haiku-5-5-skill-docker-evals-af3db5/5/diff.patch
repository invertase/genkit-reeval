diff --git a/src/agents.ts b/src/agents.ts
index e69de29..bf6176c 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -0,0 +1,48 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const ApprovalSchema = z.object({
+  approved: z.boolean().describe('Whether the refund was approved'),
+  note: z.string().optional().describe('Optional note from the approver'),
+});
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description:
+    'Asks a human approver to approve refunding an amount on an order. Nothing is refunded until the approver answers approved: true.',
+  inputSchema: z.object({
+    orderId: z.string().describe('The order id, for example A-1001'),
+    amount: z.number().describe('The amount to refund'),
+    reason: z.string().describe('Why the customer wants the refund'),
+  }),
+  outputSchema: ApprovalSchema,
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description: 'Issues a refund on an order. Only call it after approveRefund returned approved: true.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('The amount to refund'),
+    }),
+    outputSchema: z.object({ refundId: z.string() }),
+  },
+  async ({ orderId, amount }) => ({ refundId: createRefund(orderId, amount) }),
+);
+
+/** Handles refund requests: looks up the order, asks a human to approve, then issues the refund. */
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  system:
+    'You are the refund desk of Northwind Supplies. Keep every reply to the customer to one or two sentences.\n' +
+    'For a refund request:\n' +
+    '1. Look up the order with lookupOrder, using the order id in uppercase such as A-1001. If it is not found, tell the customer and stop.\n' +
+    '2. If the order is not refundable, tell the customer it cannot be refunded and stop.\n' +
+    '3. Otherwise call approveRefund with the order id, the amount (the order total unless the customer asked for less) and the customer\'s reason. Do not call issueRefund yet.\n' +
+    '4. If approveRefund returned approved: true, call issueRefund with the same order id and amount, then tell the customer the refund was issued and quote its refund id.\n' +
+    '5. If approveRefund returned approved: false, do not call issueRefund. Tell the customer the refund could not be approved. Do not repeat internal notes.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
