+++ b/src/agents.ts
@@ -0,0 +1,62 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const RefundRequestSchema = z.object({
+  orderId: z.string().describe('The order id, for example A-1001'),
+  amount: z.number().describe('Amount to refund, in the order currency'),
+  reason: z.string().describe('Why the customer wants the refund, in a few words'),
+});
+
+const ApprovalSchema = z.object({
+  approved: z.boolean(),
+  note: z.string().optional(),
+});
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description:
+    'Asks a human agent to approve a refund for an order before it is issued. ' +
+    'The conversation pauses until the human answers with approved true or false.',
+  inputSchema: RefundRequestSchema,
+  outputSchema: ApprovalSchema,
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description:
+      'Issues the refund for an order and returns its refund id. ' +
+      'Only call it after approveRefund answered approved true for the same order and amount.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('Amount to refund, in the order currency'),
+    }),
+    outputSchema: z.object({
+      refundId: z.string().optional(),
+      error: z.string().optional(),
+    }),
+  },
+  async ({ orderId, amount }) => {
+    try {
+      return { refundId: createRefund(orderId, amount) };
+    } catch (e) {
+      return { error: e instanceof Error ? e.message : String(e) };
+    }
+  },
+);
+
+/** Handles refund requests and pauses for a human to approve each refund before issuing it. */
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  description: 'Handles customer refund requests, with human approval before any refund is issued.',
+  system:
+    'You are the refund desk of Northwind Supplies. Keep each reply to one or two sentences. Follow these steps:\n' +
+    '1. Look up the order with lookupOrder. If the order is not found, or its refundable field is false, tell the customer and stop.\n' +
+    '2. Otherwise call approveRefund once, with the order id, the order total as the amount, and the customer\'s reason. ' +
+    'Call it alone, not together with any other tool. Wait for the answer.\n' +
+    '3. If the answer is approved true, call issueRefund with the same order id and amount, then tell the customer the refund id.\n' +
+    '4. If the answer is approved false, do not call issueRefund. Tell the customer the refund was not approved.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
