diff --git a/src/agents.ts b/src/agents.ts
index e69de29..0061cdb 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -0,0 +1,47 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description:
+    'Asks a human to approve refunding an order. Call it once per refund request, after lookupOrder shows the order is refundable.',
+  inputSchema: z.object({
+    orderId: z.string().describe('The order id, for example A-1001'),
+    amount: z.number().describe('Amount to refund'),
+    reason: z.string().describe('Why the customer wants the refund'),
+  }),
+  outputSchema: z.object({
+    approved: z.boolean(),
+    note: z.string().optional(),
+  }),
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description:
+      'Issues a refund for an order and returns its refund id. Only call it after approveRefund returned approved: true.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('Amount to refund, as approved'),
+    }),
+    outputSchema: z.object({ refundId: z.string() }),
+  },
+  async ({ orderId, amount }) => ({ refundId: createRefund(orderId, amount) }),
+);
+
+/** Handles refund requests: looks up the order, waits for human approval, then issues the refund if approved. */
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  system: [
+    'You are the refund desk of Northwind Supplies. Keep every reply to the customer to one or two sentences.',
+    'For a refund request, call lookupOrder with the order id the customer gave.',
+    'If the order is not found or is not refundable, tell the customer and do not call approveRefund.',
+    'Otherwise call approveRefund once, with the order id, the order total as the amount, and the customer reason.',
+    'If approveRefund returns approved: true, call issueRefund with the same order id and amount, then tell the customer the refund id.',
+    'If approveRefund returns approved: false, do not call issueRefund. Tell the customer the refund was not approved.',
+  ].join(' '),
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
