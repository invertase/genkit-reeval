@@ -0,0 +1,50 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+/** Pauses the agent until a human approves or declines the refund. */
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description:
+    'Asks a human to approve or decline a refund for an order. Call it alone, in its own step, and wait for the answer.',
+  inputSchema: z.object({
+    orderId: z.string().describe('The order id, for example A-1001'),
+    amount: z.number().describe('The amount to refund'),
+    reason: z.string().describe('Why the customer wants the refund'),
+  }),
+  outputSchema: z.object({
+    approved: z.boolean(),
+    note: z.string().optional(),
+  }),
+});
+
+/** Issues a refund for an order. Only call it after approveRefund returned approved: true. */
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description:
+      'Issues a refund for an order with the same orderId and amount that approveRefund approved. Returns the refund id.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('The amount to refund'),
+    }),
+    outputSchema: z.object({ refundId: z.string() }),
+  },
+  async ({ orderId, amount }) => ({ refundId: createRefund(orderId, amount) }),
+);
+
+/** Handles refund requests: looks up the order, gets human approval, then issues the refund. */
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  description: 'Handles refund requests, with human approval before any refund is issued.',
+  system:
+    'You are the refund desk of Northwind Supplies. Handle refund requests in this order:\n' +
+    '1. Look the order up with lookupOrder. If it does not exist or refundable is false, tell the customer the order cannot be refunded and stop.\n' +
+    '2. Otherwise call approveRefund with the order id, the refund amount (the order total unless the customer asked for less) and the reason. ' +
+    'Call approveRefund alone, never in the same step as issueRefund.\n' +
+    '3. If approved is true, call issueRefund with the same orderId and amount, then tell the customer the refund id.\n' +
+    '4. If approved is false, do not call issueRefund. Tell the customer briefly that the refund was not approved.\n' +
+    'Keep replies to the customer to one or two sentences.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
