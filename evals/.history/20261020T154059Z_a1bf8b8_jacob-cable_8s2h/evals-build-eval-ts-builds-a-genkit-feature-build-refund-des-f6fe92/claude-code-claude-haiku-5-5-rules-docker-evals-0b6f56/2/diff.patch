diff --git a/src/agents.ts b/src/agents.ts
index e69de29..d9fea5d 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -0,0 +1,54 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const RefundRequestSchema = z.object({
+  orderId: z.string().describe('The order id, for example A-1001'),
+  amount: z.number().describe('The amount to refund'),
+  reason: z.string().describe('Why the customer wants the refund'),
+});
+
+const ApprovalSchema = z.object({
+  approved: z.boolean(),
+  note: z.string().optional(),
+});
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description: 'Asks a human to approve a refund before it is issued. Returns the decision.',
+  inputSchema: RefundRequestSchema,
+  outputSchema: ApprovalSchema,
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description:
+      'Issues a refund for an order and returns its refund id. ' +
+      'Only call this after approveRefund returned approved: true for the same order and amount.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('The amount to refund'),
+    }),
+    outputSchema: z.object({ refundId: z.string() }),
+  },
+  async ({ orderId, amount }) => ({ refundId: createRefund(orderId, amount) }),
+);
+
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  description: 'Handles customer refund requests, with human approval before any refund is issued.',
+  system:
+    'You are the refund desk at Northwind Supplies. Handle a refund request in this order:\n' +
+    '1. Look the order up with lookupOrder. If it is not found or refundable is false, do not request a refund; ' +
+    'tell the customer in one or two sentences why it cannot be refunded.\n' +
+    '2. Otherwise call approveRefund with the order id in uppercase, the order total from lookupOrder as the amount ' +
+    '(unless the customer asked for less), and a short reason taken from what the customer said.\n' +
+    '3. If approveRefund returned approved: true, call issueRefund with the same order id and amount, then tell the customer ' +
+    'in one or two sentences that the refund was issued, quoting the refund id.\n' +
+    '4. If approveRefund returned approved: false, do not call issueRefund. Tell the customer in one or two sentences that ' +
+    'the refund was not approved. Do not repeat the internal note.\n' +
+    'Never call issueRefund unless approveRefund returned approved: true for that order.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
