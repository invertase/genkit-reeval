@@ -0,0 +1,79 @@
+import { generateMiddleware, type MessageData, z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const RefundRequestSchema = z.object({
+  orderId: z.string().describe('The order id, for example A-1001'),
+  amount: z.number().describe('Amount to refund, in the order currency'),
+  reason: z.string().describe('Why the customer wants a refund'),
+});
+
+const ApprovalSchema = z.object({
+  approved: z.boolean(),
+  note: z.string().optional(),
+});
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description: 'Asks a human to approve a refund. The conversation pauses until they answer.',
+  inputSchema: RefundRequestSchema,
+  outputSchema: ApprovalSchema,
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description: 'Issues a refund for an order. Only call it after approveRefund returned approved: true.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('Amount to refund'),
+    }),
+    outputSchema: z.object({ refundId: z.string() }),
+  },
+  async ({ orderId, amount }) => ({ refundId: createRefund(orderId, amount) }),
+);
+
+const hasUnusedApproval = (messages: MessageData[]): boolean => {
+  for (let i = messages.length - 1; i >= 0; i--) {
+    const parts = messages[i]?.content ?? [];
+    for (let j = parts.length - 1; j >= 0; j--) {
+      const part = parts[j];
+      if (part?.toolRequest?.name === 'issueRefund') return false;
+      if (part?.toolResponse?.name === 'approveRefund') {
+        return ApprovalSchema.safeParse(part.toolResponse.output).data?.approved === true;
+      }
+    }
+  }
+  return false;
+};
+
+// Hides issueRefund from the model unless the latest approval is a yes that no refund has used yet.
+const issueRefundOnlyAfterApproval = generateMiddleware(
+  { name: 'issueRefundOnlyAfterApproval', description: 'Offers issueRefund only after an approved approveRefund.' },
+  () => ({
+    model: async (req, ctx, next) =>
+      next(
+        hasUnusedApproval(req.messages)
+          ? req
+          : { ...req, tools: req.tools?.filter((tool) => tool.name !== 'issueRefund') },
+        ctx,
+      ),
+  }),
+);
+
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  description: 'Handles refund requests: checks the order, asks a human to approve, then issues the refund.',
+  system:
+    'You are the refund desk at Northwind Supplies. Handle a refund request like this:\n' +
+    '1. Look up the order the customer names with lookupOrder. If there is no such order, or it is not refundable, ' +
+    'tell the customer in one or two sentences and stop.\n' +
+    '2. Otherwise call approveRefund with the order id, the order total as the amount, and a one-sentence reason from the customer.\n' +
+    '3. When approveRefund returns approved: true, call issueRefund with the same order id and amount, then tell the customer ' +
+    'their refund id. When it returns approved: false, do not issue a refund; tell the customer in one or two sentences ' +
+    'that the refund was not approved. Do not repeat the approver\'s note to the customer.\n' +
+    'Keep every reply to the customer short.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+  use: [issueRefundOnlyAfterApproval()],
+});
