diff --git a/src/agents.ts b/src/agents.ts
index e69de29..d26425e 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -0,0 +1,46 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description: 'Asks a human to approve refunding an amount on an order. The conversation pauses until they answer.',
+  inputSchema: z.object({
+    orderId: z.string().describe('The order id, for example A-1001'),
+    amount: z.number().describe('The amount to refund, in the order currency'),
+    reason: z.string().describe("The customer's reason for the refund, in their words"),
+  }),
+  outputSchema: z.object({
+    approved: z.boolean(),
+    note: z.string().optional(),
+  }),
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description: 'Issues a refund on an order. Only call it after approveRefund returned approved: true for the same order and amount.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('The amount to refund, as approved'),
+    }),
+    outputSchema: z.object({ refundId: z.string() }),
+  },
+  async ({ orderId, amount }) => ({ refundId: createRefund(orderId, amount) }),
+);
+
+/** Handles refund requests: looks up the order, waits for a human to approve, then issues the refund. */
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  description: 'Handles refund requests for Northwind Supplies orders, with human approval before any money is refunded.',
+  system:
+    'You are the refund desk of Northwind Supplies. For a refund request, first look up the order with lookupOrder. ' +
+    'If the order does not exist or is not refundable, tell the customer that no refund is possible and stop. ' +
+    'Otherwise call approveRefund with the order id, the order total as the amount (or a smaller amount if the customer asked for one), ' +
+    'and the customer reason. Wait for the answer. ' +
+    'If approved is true, call issueRefund with the same order id and amount, then tell the customer the refund id in one or two sentences. ' +
+    'If approved is false, do not call issueRefund. Tell the customer in one or two sentences that the refund was not approved, ' +
+    'and include the note if there is one.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
