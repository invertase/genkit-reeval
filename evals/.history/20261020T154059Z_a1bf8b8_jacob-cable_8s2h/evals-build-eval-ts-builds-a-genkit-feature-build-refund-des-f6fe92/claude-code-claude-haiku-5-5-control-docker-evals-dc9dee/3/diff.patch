diff --git a/src/agents.ts b/src/agents.ts
index e69de29..1d5529e 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -0,0 +1,47 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description:
+    'Asks a human support lead to approve or decline a refund. Pauses the conversation until the human answers.',
+  inputSchema: z.object({
+    orderId: z.string().describe('The order id, for example A-1001'),
+    amount: z.number().describe('The amount to refund'),
+    reason: z.string().describe("The customer's reason for the refund"),
+  }),
+  outputSchema: z.object({
+    approved: z.boolean(),
+    note: z.string().optional(),
+  }),
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description:
+      'Issues a refund against an order and returns the refund id. Only call it after approveRefund returned approved: true.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('The amount to refund'),
+    }),
+    outputSchema: z.string(),
+  },
+  async ({ orderId, amount }) => createRefund(orderId, amount),
+);
+
+/** Handles a refund request: looks up the order, waits for human approval, then issues the refund. */
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  description: 'Handles refund requests for Northwind Supplies orders, with human approval before any refund is issued.',
+  system:
+    'You are the refund desk at Northwind Supplies. For each refund request:\n' +
+    '1. Call lookupOrder with the order id the customer gave. If the order does not exist or its refundable field is false, tell the customer and stop.\n' +
+    '2. Otherwise call approveRefund with the order id, the amount to refund (the order total unless the customer asked for less) and the customer\'s reason.\n' +
+    '3. If approveRefund returns approved: true, call issueRefund with the same order id and amount, then tell the customer the refund is issued.\n' +
+    '4. If approveRefund returns approved: false, do not call issueRefund. Tell the customer the refund was declined, and include the note if there is one.\n' +
+    'Keep every reply to the customer to one or two sentences.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
