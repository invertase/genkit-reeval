diff --git a/src/agents.ts b/src/agents.ts
index e69de29..fd9bd54 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -0,0 +1,49 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description:
+    'Asks a human to approve a refund before it is issued. Wait for the answer; do not issue the refund until it is approved.',
+  inputSchema: z.object({
+    orderId: z.string().describe('The order id, for example A-1001'),
+    amount: z.number().describe('The refund amount'),
+    reason: z.string().describe('Why the customer wants the refund, in their words'),
+  }),
+  outputSchema: z.object({
+    approved: z.boolean(),
+    note: z.string().optional(),
+  }),
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description:
+      'Issues a refund against an order and returns its refund id. ' +
+      'Only call it after approveRefund returned approved: true for the same order.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('The refund amount'),
+    }),
+    outputSchema: z.object({ refundId: z.string() }),
+  },
+  async ({ orderId, amount }) => ({ refundId: createRefund(orderId, amount) }),
+);
+
+/** Handles refund requests: looks up the order, waits for a human to approve, then issues the refund. */
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  description: 'Handles refund requests for Northwind Supplies, with human approval before any refund is issued.',
+  system:
+    'You handle refund requests for Northwind Supplies. Follow these steps in order:\n' +
+    '1. Call lookupOrder with the order id. If the order is not found or refundable is false, tell the customer the order cannot be refunded and stop.\n' +
+    '2. Otherwise call approveRefund with the order id, the amount (the order total, unless the customer asks for less) and the customer\'s reason. ' +
+    'Call approveRefund alone and wait for its answer before doing anything else.\n' +
+    '3. If approved is true, call issueRefund with the same order id and amount, then tell the customer the refund id.\n' +
+    '4. If approved is false, do not issue any refund. Tell the customer in one or two sentences that the refund was not approved, mentioning the note if there is one.\n' +
+    'Keep every reply to the customer to one or two sentences.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
