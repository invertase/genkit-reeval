diff --git a/src/agents.ts b/src/agents.ts
index e69de29..952a4f5 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -0,0 +1,43 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description: 'Asks a human to approve refunding an order. Pauses the conversation until the human answers.',
+  inputSchema: z.object({
+    orderId: z.string().describe('The order id, for example A-1001'),
+    amount: z.number().describe('The amount to refund, in the order currency'),
+    reason: z.string().describe('Why the customer wants a refund'),
+  }),
+  outputSchema: z.object({
+    approved: z.boolean(),
+    note: z.string().optional(),
+  }),
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description: 'Issues a refund for an order. Only call it after approveRefund returned approved: true.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('The amount to refund'),
+    }),
+    outputSchema: z.object({ refundId: z.string() }),
+  },
+  async ({ orderId, amount }) => ({ refundId: createRefund(orderId, amount) }),
+);
+
+/** Handles refund requests: looks up the order, waits for human approval, then issues the refund. */
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  system:
+    'You are the refund desk of Northwind Supplies. For a refund request, first look up the order with lookupOrder. ' +
+    'If the order does not exist or is not refundable, tell the customer and do not refund. ' +
+    'Otherwise call approveRefund with the order id, the order total as the amount, and the customer\'s reason, then wait for the answer. ' +
+    'If it is approved, call issueRefund with the same order id and amount, then tell the customer the refund id in one or two sentences. ' +
+    'If it is declined, do not call issueRefund; tell the customer in one or two sentences that the refund was not approved.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
