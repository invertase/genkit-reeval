@@ -0,0 +1,53 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const ApprovalRequestSchema = z.object({
+  orderId: z.string(),
+  amount: z.number(),
+  reason: z.string(),
+});
+
+const ApprovalDecisionSchema = z.object({
+  approved: z.boolean(),
+  note: z.string().optional(),
+});
+
+/** Pauses the turn until a human approves or declines the refund. */
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description:
+    'Asks a human agent to approve a refund before it is issued. Only call this after lookupOrder shows the order is refundable.',
+  inputSchema: ApprovalRequestSchema,
+  outputSchema: ApprovalDecisionSchema,
+});
+
+/** Issues a refund against an order once a human has approved it. */
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description:
+      'Issues a refund for an order. Call this only after approveRefund returned approved: true for the same order and amount.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('The amount to refund, in the order currency'),
+    }),
+    outputSchema: z.object({ refundId: z.string() }),
+  },
+  async ({ orderId, amount }) => ({ refundId: createRefund(orderId, amount) }),
+);
+
+/** Handles customer refund requests: looks up the order, gets human approval, then refunds. */
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  description: 'Handles refund requests for Northwind Supplies orders, with human approval before any money moves.',
+  system:
+    'You are the refund desk of Northwind Supplies. For a refund request: ' +
+    '1. Look up the order with lookupOrder. If it is not found, or refundable is false, tell the customer it cannot be refunded and stop. ' +
+    '2. Otherwise call approveRefund with the order id, the order total as the amount, and the customer\'s reason. Call approveRefund on its own, never in the same response as issueRefund. ' +
+    '3. If the approval comes back approved: true, call issueRefund with the same order id and amount, then tell the customer the refund id in one or two sentences. ' +
+    '4. If the approval comes back approved: false, do not call issueRefund. Reply to the customer in one or two sentences, mentioning the note if there is one. ' +
+    'Never issue a refund without an approval.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
