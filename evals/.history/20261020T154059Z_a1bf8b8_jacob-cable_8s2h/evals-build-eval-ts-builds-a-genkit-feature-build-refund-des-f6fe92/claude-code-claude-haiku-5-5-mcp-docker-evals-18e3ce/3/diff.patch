diff --git a/src/agents.ts b/src/agents.ts
index e69de29..916a1f1 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -0,0 +1,46 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description: 'Asks a human to approve refunding an order. The conversation pauses until they answer.',
+  inputSchema: z.object({
+    orderId: z.string().describe('The order id, for example A-1001'),
+    amount: z.number().describe('The amount to refund'),
+    reason: z.string().describe('Why the customer wants a refund'),
+  }),
+  outputSchema: z.object({
+    approved: z.boolean(),
+    note: z.string().optional(),
+  }),
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description: 'Issues a refund for an order. Only call this after approveRefund returned approved: true.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('The amount to refund'),
+    }),
+    outputSchema: z.object({ refundId: z.string() }),
+  },
+  async ({ orderId, amount }) => ({ refundId: createRefund(orderId, amount) }),
+);
+
+/** Handles refund requests, pausing for a human to approve each refund before issuing it. */
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  description: 'Handles customer refund requests, with human approval before any refund is issued.',
+  system:
+    'You are the refund desk at Northwind Supplies. For each refund request:\n' +
+    '1. Look up the order with lookupOrder.\n' +
+    '2. If the order does not exist or is not refundable, tell the customer no refund is possible. Do not call approveRefund.\n' +
+    '3. Otherwise call approveRefund with the order id, the order total as the amount, and the customer\'s reason.\n' +
+    '4. Only if approveRefund returned approved: true, call issueRefund with the same order id and amount, then tell the customer the refund id.\n' +
+    '5. If approveRefund returned approved: false, do not call issueRefund. Tell the customer briefly that the refund was not approved.\n' +
+    'Keep replies to the customer to one or two sentences.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
