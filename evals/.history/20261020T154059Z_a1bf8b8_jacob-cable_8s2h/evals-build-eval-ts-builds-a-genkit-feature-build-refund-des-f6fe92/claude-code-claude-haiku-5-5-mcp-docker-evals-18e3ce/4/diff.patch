diff --git a/src/agents.ts b/src/agents.ts
index e69de29..eb11777 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -0,0 +1,104 @@
+import { generateMiddleware, z, type MessageData, type ToolResponsePart } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const ApproveRefundInput = z.object({
+  orderId: z.string().describe('The order id, for example A-1001'),
+  amount: z.number().describe('The amount to refund'),
+  reason: z.string().describe('Why the customer wants the refund'),
+});
+
+const ApproveRefundAnswer = z.object({ approved: z.boolean(), note: z.string().optional() });
+
+const IssueRefundInput = z.object({
+  orderId: z.string().describe('The order id the approved refund is for'),
+  amount: z.number().describe('The amount that approveRefund approved'),
+});
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description: 'Asks a human to approve refunding an order. Returns whether the refund was approved.',
+  inputSchema: ApproveRefundInput,
+  outputSchema: ApproveRefundAnswer,
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description: 'Issues a refund for an order that approveRefund approved. Returns the refund id, or an error.',
+    inputSchema: IssueRefundInput,
+    outputSchema: z.object({ refundId: z.string().nullable(), error: z.string().nullable() }),
+  },
+  async ({ orderId, amount }) => {
+    try {
+      return { refundId: createRefund(orderId, amount), error: null };
+    } catch (err) {
+      return { refundId: null, error: err instanceof Error ? err.message : String(err) };
+    }
+  },
+);
+
+const refundKey = ({ orderId, amount }: { orderId: string; amount: number }) => `${orderId}|${amount}`;
+
+const approvedRefunds = (messages: MessageData[], respond: ToolResponsePart[] = []): string[] => {
+  const requests = messages
+    .flatMap((message) => message.content)
+    .flatMap((part) => (part.toolRequest?.name === 'approveRefund' ? [part.toolRequest] : []));
+  const keys: string[] = [];
+  for (const { toolResponse } of respond) {
+    const answer = ApproveRefundAnswer.safeParse(toolResponse.output);
+    const request = requests.filter((r) => r.ref === toolResponse.ref).at(-1);
+    const input = ApproveRefundInput.safeParse(request?.input);
+    if (toolResponse.name === 'approveRefund' && answer.success && answer.data.approved && input.success) {
+      keys.push(refundKey(input.data));
+    }
+  }
+  return keys;
+};
+
+// issueRefund runs only for an order and amount a human approved this turn; each approval is used once.
+const refundApprovalGate = generateMiddleware(
+  {
+    name: 'refundApprovalGate',
+    description: 'Lets issueRefund run only for an order and amount that approveRefund approved this turn.',
+  },
+  () => {
+    const approvals: string[] = [];
+    return {
+      generate: async (envelope, ctx, next) => {
+        approvals.push(...approvedRefunds(envelope.request.messages, envelope.request.resume?.respond));
+        return next(envelope, ctx);
+      },
+      tool: async (req, ctx, next) => {
+        if (req.toolRequest?.name !== 'issueRefund') return next(req, ctx);
+        const input = IssueRefundInput.safeParse(req.toolRequest.input);
+        const index = input.success ? approvals.indexOf(refundKey(input.data)) : -1;
+        if (index === -1) {
+          return {
+            toolResponse: {
+              name: 'issueRefund',
+              ref: req.toolRequest.ref,
+              output: { refundId: null, error: 'This refund has not been approved.' },
+            },
+          };
+        }
+        approvals.splice(index, 1);
+        return next(req, ctx);
+      },
+    };
+  },
+);
+
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  system:
+    'You are the refund desk at Northwind Supplies. For a refund request: ' +
+    '1. Look the order up with lookupOrder. If the order does not exist or is not refundable, tell the customer and stop. ' +
+    "2. Otherwise call approveRefund with the order id, the order total as the amount, and the customer's reason. " +
+    '3. If approveRefund approved it, call issueRefund with the same order id and amount, then tell the customer the refund id. ' +
+    '4. If it was declined, do not call issueRefund. Reply to the customer in one or two sentences without repeating internal notes. ' +
+    'Never call issueRefund for anything approveRefund has not approved.',
+  tools: [lookupOrder, approveRefund, issueRefund],
+  use: [refundApprovalGate()],
+});
