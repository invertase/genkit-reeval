diff --git a/src/agents.ts b/src/agents.ts
index e69de29..fd6a07a 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -0,0 +1,48 @@
+import { z } from 'genkit/beta';
+import { ai } from './ai.js';
+import { createRefund } from './db.js';
+import { lookupOrder } from './tools.js';
+
+const approveRefund = ai.defineInterrupt({
+  name: 'approveRefund',
+  description:
+    'Pauses the conversation until a human agent approves or declines a refund. ' +
+    'Call it once per refund, after lookupOrder has confirmed the order is refundable.',
+  inputSchema: z.object({
+    orderId: z.string().describe('The order id, for example A-1001'),
+    amount: z.number().describe('The amount to refund'),
+    reason: z.string().describe('Why the customer wants a refund'),
+  }),
+  outputSchema: z.object({
+    approved: z.boolean(),
+    note: z.string().optional(),
+  }),
+});
+
+const issueRefund = ai.defineTool(
+  {
+    name: 'issueRefund',
+    description: 'Issues a refund for an order. Only call it after approveRefund returned approved: true.',
+    inputSchema: z.object({
+      orderId: z.string().describe('The order id, for example A-1001'),
+      amount: z.number().describe('The amount to refund'),
+    }),
+    outputSchema: z.object({ refundId: z.string() }),
+  },
+  async ({ orderId, amount }) => ({ refundId: createRefund(orderId, amount) }),
+);
+
+export const refundAgent = ai.defineAgent({
+  name: 'refundAgent',
+  description: 'Handles refund requests: looks up the order, waits for human approval, then issues the refund.',
+  system: [
+    'You are the refund desk at Northwind Supplies. Handle refund requests in these steps.',
+    'Call one tool at a time and wait for its result before calling the next.',
+    '1. Call lookupOrder with the order id the customer gave. If it returns null or refundable is false, do not refund; tell the customer briefly why.',
+    "2. If the order is refundable, call approveRefund with the orderId, the order's total as amount, and the customer's reason.",
+    '3. If the approval comes back approved: true, call issueRefund with the same orderId and amount, then tell the customer the refund was issued and quote its refundId.',
+    '4. If the approval comes back approved: false, do not call issueRefund; tell the customer briefly that the refund was declined. Do not repeat the approval note to the customer.',
+    'Keep every reply to the customer to one or two sentences.',
+  ].join('\n'),
+  tools: [lookupOrder, approveRefund, issueRefund],
+});
