@@ -0,0 +1,6 @@
+{
+  "file": "src/tools.ts",
+  "snippet": "async ({ orderId }) => ORDERS[orderId] ?? null,",
+  "cause": "The lookupOrder tool indexes the orders record with the customer's raw orderId, so a lowercase or padded id such as \"a-1001\" misses the stored key \"A-1001\" and returns null, which the model reports as not found.",
+  "evidence": "Before the fix, lookupOrder({orderId: \"A-1001\"}) returned the shipped record while lookupOrder({orderId: \"a-1001\"}) and lookupOrder({orderId: \" A-1001 \"}) returned null; src/orders.json keys are uppercase and nothing in src normalizes ids. After changing the lookup to ORDERS[orderId.trim().toUpperCase()], all three forms return the shipped record and an unknown id still returns null; tsc --noEmit passes."
+}
