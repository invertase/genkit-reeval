+{
+  "file": "src/tools.ts",
+  "snippet": "async ({ orderId }) => ORDERS[orderId] ?? null,",
+  "cause": "lookupOrder used the customer's raw orderId as an exact, case-sensitive key into ORDERS, so a lowercase id like \"a-1001\" missed the \"A-1001\" record and returned null, which the model reported as a nonexistent order.",
+  "evidence": "src/orders.json and src/db.ts key orders in uppercase; ORDERS[\"a-1001\"] is undefined while ORDERS[\"A-1001\"] has status shipped. After the fix, lookupOrder with \"a-1001\" and \"A-1001\" returns the same shipped record and an unknown id still returns null."
+}
