+import { ai } from './ai.js';
+import { lookupOrder } from './tools.js';
+
+/** Order desk agent: answers order status, delivery date and tracking questions across a multi-turn chat. */
+export const orderAgent = ai.defineAgent({
+  name: 'orderAgent',
+  description: 'Answers customer questions about order status, delivery date and tracking code.',
+  system:
+    'You are the Northwind Supplies order desk. Answer questions about orders using the lookupOrder tool. ' +
+    'Quote the status, delivery date (ETA) and tracking code exactly as the tool returns them. ' +
+    'If the tracking code is null, say no tracking code is available yet. If an order is not found, say so and ask the customer to check the order id. ' +
+    'Keep replies to one or two sentences. Use what the customer told you earlier in the conversation, such as their name or order id.',
+  tools: [lookupOrder],
+});
