+import { ai } from './ai.js';
+import { lookupOrder } from './tools.js';
+
+/** Multi-turn order desk agent; callers hold the conversation with `orderAgent.chat()`. */
+export const orderAgent = ai.defineAgent({
+  name: 'orderAgent',
+  description: 'Answers customer questions about the status, delivery date and tracking code of their orders.',
+  system:
+    'You are the order desk of Northwind Supplies. Answer questions about orders using the lookupOrder tool. ' +
+    'Quote the status, ETA and tracking code exactly as the tool returns them. If an order is not found, say so. ' +
+    'Keep replies short.',
+  tools: [lookupOrder],
+});
