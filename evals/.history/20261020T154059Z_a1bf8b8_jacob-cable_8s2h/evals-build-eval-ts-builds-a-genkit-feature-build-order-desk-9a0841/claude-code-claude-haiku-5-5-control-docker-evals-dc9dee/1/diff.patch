+/** Multi-turn order desk agent; callers start a conversation with `orderAgent.chat()`. */
+export const orderAgent = ai.defineAgent({
+  name: 'orderAgent',
+  description: 'Answers customer questions about order status, delivery date and tracking code.',
+  system:
+    'You are the Northwind Supplies order desk. Answer questions about orders using the lookupOrder tool. ' +
+    'Quote the status, ETA and tracking code exactly as the tool returns them. ' +
+    'If there is no tracking code yet, say so. If an order is not found, say so.',
+  tools: [lookupOrder],
+});
