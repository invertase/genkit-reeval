+import { ai } from './ai.js';
+import { lookupOrder } from './tools.js';
+
+/** Multi-turn order desk agent; call `orderAgent.chat()` to start a conversation. */
+export const orderAgent = ai.defineAgent({
+  name: 'orderAgent',
+  system:
+    'You are the order desk at Northwind Supplies. Answer customers\' questions about their orders: ' +
+    'status, delivery date and tracking code. Look up every order with the lookupOrder tool and quote ' +
+    'the status, ETA and tracking code exactly as the tool returns them. If the tool returns no order, say so. ' +
+    'If an order has no tracking code yet, say that none is available.',
+  tools: [lookupOrder],
+});
