diff --git a/src/agents.ts b/src/agents.ts
index 42df985..9328673 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,42 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description: 'Passes an order question to the order desk and returns its answer.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description: 'Passes a refund request to the refund desk and returns its answer.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.finishReason === 'interrupted') return 'The refund is waiting for human approval and has not been issued.';
+    return response.text;
+  },
+);
+
+/** Front desk the customer talks to first; hands order and refund requests to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Hands order questions and refund requests to the specialist agents.',
+  system:
+    'You are the Northwind Supplies front desk. Greet the customer and answer small talk briefly yourself. ' +
+    'Never answer order questions or refund requests yourself: for anything about an order\'s status, delivery, tracking or total, call askOrderAgent; ' +
+    'for refund requests, call askRefundAgent. ' +
+    'Each request you pass on must be self-contained and include the order id, taken from earlier in the conversation when the customer did not repeat it. ' +
+    'Give the customer the specialist answer exactly as returned.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
