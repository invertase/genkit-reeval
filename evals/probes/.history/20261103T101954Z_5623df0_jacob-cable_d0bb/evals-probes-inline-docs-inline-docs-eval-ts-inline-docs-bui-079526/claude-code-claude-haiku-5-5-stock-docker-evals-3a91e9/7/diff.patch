diff --git a/src/agents.ts b/src/agents.ts
index 42df985..0faac65 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,45 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const handOffToOrderAgent = ai.defineTool(
+  {
+    name: 'handOffToOrderAgent',
+    description: 'Hands an order question to the order desk and returns its answer.',
+    inputSchema: z.object({
+      request: z.string().describe('A self-contained order question that includes the order id, for example "What is the status of order A-1001?"'),
+    }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const handOffToRefundAgent = ai.defineTool(
+  {
+    name: 'handOffToRefundAgent',
+    description: 'Hands a refund request to the refund desk and returns its reply.',
+    inputSchema: z.object({
+      request: z.string().describe('A self-contained refund request that includes the order id, for example "Refund order A-1001"'),
+    }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.interrupts.length > 0) return 'The refund is waiting for human approval and has not been issued.';
+    return response.text;
+  },
+);
+
+/** Front desk agent: answers general questions and hands order and refund requests to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Routes order questions and refund requests to the right desk.',
+  system:
+    'You are the Northwind Supplies front desk. Answer general questions yourself. ' +
+    'For any question about an order (status, delivery, tracking, total) call handOffToOrderAgent. ' +
+    'For any refund request call handOffToRefundAgent. Never answer order or refund questions yourself. ' +
+    'Each hand-off request must name the order id, so when the customer does not repeat it, take it from earlier in the conversation.',
+  tools: [handOffToOrderAgent, handOffToRefundAgent],
+  maxTurns: 4,
+  store,
+});
