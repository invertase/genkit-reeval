diff --git a/src/agents.ts b/src/agents.ts
index 42df985..2e8c401 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,44 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description:
+      'Hands an order question (status, delivery, tracking, total) to the order desk and returns its reply. ' +
+      'Write the question so it names the order id, since the order desk only sees this question.',
+    inputSchema: z.object({ question: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ question }) => (await orderAgent.chat().send(question)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description:
+      'Hands a refund request to the refund desk and returns its reply. ' +
+      'Write the request so it names the order id, since the refund desk only sees this request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.object({ reply: z.string(), awaitingApproval: z.boolean() }),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    return { reply: response.text, awaitingApproval: response.interrupts.length > 0 };
+  },
+);
+
+/** Customer-facing front desk; hands order and refund requests to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies customers. Routes order and refund questions to specialists.',
+  system:
+    'You are the front desk of the Northwind Supplies support team. Greet customers and work out what they need. ' +
+    'Never answer order status or refund questions yourself: for order questions call askOrderAgent, and for refund requests call askRefundAgent. ' +
+    'Customers often give an order id in one message and ask about it later, so when you hand off, include the order id from earlier in the conversation. ' +
+    'Keep your own replies to one or two sentences and relay the specialist reply to the customer.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
