diff --git a/src/agents.ts b/src/agents.ts
index 42df985..89f15c4 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,41 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description: 'Hands an order question (status, delivery, tracking, total) to the order desk. Put the order id in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description: 'Hands a refund request to the refund desk. Put the order id and the customer reason in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.interrupts.length > 0) return 'The refund is waiting for human approval before it can be issued.';
+    return response.text;
+  },
+);
+
+/** The front desk: customers talk to it first and it hands order and refund questions to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Routes order and refund questions to the right specialist.',
+  system:
+    'You are the Northwind Supplies front desk. Keep replies to one or two sentences. ' +
+    'For any question about an order, its status, delivery, tracking or total, call askOrderAgent. ' +
+    'For any refund request, call askRefundAgent. Never answer order or refund questions yourself. ' +
+    'Include the order id in every hand-off; if the customer named one earlier in the conversation, use it.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
