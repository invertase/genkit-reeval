+++ b/src/agents.ts
@@ -51,3 +51,41 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description:
+      'Hands an order question to the order desk and returns its answer. ' +
+      'The order desk does not see this conversation, so put the order id in the request, for example "Status of order A-1001?".',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description:
+      'Hands a refund request to the refund desk and returns its reply. ' +
+      'The refund desk does not see this conversation, so put the order id and the customer\'s request in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await refundAgent.chat().send(request)).text,
+);
+
+/** The front desk: the first agent a customer talks to. It hands order and refund requests to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies customers. Hands order and refund questions to specialist agents.',
+  system:
+    'You are the Northwind Supplies front desk. Greet customers and answer general questions yourself. ' +
+    'For any question about an order, its status, delivery or tracking, call askOrderAgent. ' +
+    'For any refund request, call askRefundAgent. Do not answer order or refund questions yourself. ' +
+    'Remember order ids and details the customer gives you, and include them in each request you hand off.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
