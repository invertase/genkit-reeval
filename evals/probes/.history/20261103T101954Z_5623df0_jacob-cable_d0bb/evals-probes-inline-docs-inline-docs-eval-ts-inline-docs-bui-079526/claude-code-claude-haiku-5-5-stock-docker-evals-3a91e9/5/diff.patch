diff --git a/src/agents.ts b/src/agents.ts
index 42df985..469bcd5 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,44 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description: 'Hands an order question to the order desk, which looks up the order and answers it.',
+    inputSchema: z.object({
+      request: z.string().describe('The question with its order id, for example "Status of order A-1001"'),
+    }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description: 'Hands a refund request to the refund desk. Refunds wait for human approval.',
+    inputSchema: z.object({
+      request: z.string().describe('The refund request with its order id, for example "Refund order A-1001"'),
+    }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    return response.interrupts.length > 0 ? 'The refund is waiting for human approval.' : response.text;
+  },
+);
+
+/** Front desk the customer talks to first; hands order and refund questions to the desks. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies customers. Routes order questions and refund requests to the right desk.',
+  system:
+    'You are the Northwind Supplies front desk. Never answer order or refund questions yourself. ' +
+    'Send order questions to askOrderAgent and refund requests to askRefundAgent. ' +
+    'Restate the order id from earlier in the conversation in the request when the customer does not repeat it. ' +
+    'Pass the desk reply on to the customer in one or two sentences.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
