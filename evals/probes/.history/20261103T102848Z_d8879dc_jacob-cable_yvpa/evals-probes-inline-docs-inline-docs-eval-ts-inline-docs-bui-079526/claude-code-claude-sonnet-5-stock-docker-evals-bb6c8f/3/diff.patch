diff --git a/src/agents.ts b/src/agents.ts
index 42df985..3355d2e 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,57 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const TriageStateSchema = z.object({
+  orderSessionId: z.string().optional(),
+  refundSessionId: z.string().optional(),
+});
+
+const askOrderDesk = ai.defineTool(
+  {
+    name: 'askOrderDesk',
+    description: "Hands an order question (status, delivery, tracking, total) to the order desk and returns its answer.",
+    inputSchema: z.object({ question: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ question }) => {
+    const session = ai.currentSession<z.infer<typeof TriageStateSchema>>();
+    const orderSessionId = session.getCustom()?.orderSessionId;
+    const chat = orderSessionId ? await orderAgent.loadChat({ sessionId: orderSessionId }) : orderAgent.chat();
+    const response = await chat.send(question);
+    session.updateCustom((custom) => ({ ...custom, orderSessionId: chat.sessionId }));
+    return response.text;
+  },
+);
+
+const askRefundDesk = ai.defineTool(
+  {
+    name: 'askRefundDesk',
+    description: 'Hands a refund request to the refund desk and returns its answer.',
+    inputSchema: z.object({ question: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ question }) => {
+    const session = ai.currentSession<z.infer<typeof TriageStateSchema>>();
+    const refundSessionId = session.getCustom()?.refundSessionId;
+    const chat = refundSessionId ? await refundAgent.loadChat({ sessionId: refundSessionId }) : refundAgent.chat();
+    const response = await chat.send(question);
+    session.updateCustom((custom) => ({ ...custom, refundSessionId: chat.sessionId }));
+    return response.text;
+  },
+);
+
+/** Front desk agent customers talk to first; hands order questions and refund requests off to the right specialist. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Greets the customer and routes their request to the order desk or the refund desk.',
+  system:
+    'You are the Northwind Supplies front desk. You do not answer order or refund questions yourself. ' +
+    'For questions about an order (status, delivery, tracking, total) call askOrderDesk. ' +
+    'For refund requests call askRefundDesk. Relay the specialist answer back to the customer. ' +
+    'When the customer does not name an order, pass along what they said earlier in the conversation.',
+  stateSchema: TriageStateSchema,
+  tools: [askOrderDesk, askRefundDesk],
+  maxTurns: 4,
+  store,
+});
