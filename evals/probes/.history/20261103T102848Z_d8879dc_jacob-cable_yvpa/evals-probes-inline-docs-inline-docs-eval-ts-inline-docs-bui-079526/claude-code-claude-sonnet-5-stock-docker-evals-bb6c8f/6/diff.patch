diff --git a/src/agents.ts b/src/agents.ts
index 42df985..72a306f 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,48 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description:
+      'Asks the order desk about an order: its status, delivery date, tracking code or total. ' +
+      'Pass the full question, including the order id when the customer gave one earlier in the conversation.',
+    inputSchema: z.object({ question: z.string() }),
+    outputSchema: z.object({ answer: z.string() }),
+  },
+  async ({ question }) => {
+    const res = await orderAgent.chat().send(question);
+    return { answer: res.text };
+  },
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description:
+      'Asks the refund desk to handle a refund request for an order. ' +
+      'Pass the full request, including the order id when the customer gave one earlier in the conversation.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.object({ answer: z.string() }),
+  },
+  async ({ request }) => {
+    const res = await refundAgent.chat().send(request);
+    const answer = res.finishReason === 'interrupted' ? 'This refund is waiting on human approval.' : res.text;
+    return { answer };
+  },
+);
+
+/** Front desk agent: greets the customer and routes them to the order or refund desk. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk agent that customers talk to first. Routes order questions and refund requests to the right desk.',
+  system:
+    'You are the Northwind Supplies front desk. Greet the customer and figure out what they need. ' +
+    'For questions about an order (status, delivery date, tracking code or total), call askOrderAgent - never answer those yourself. ' +
+    'For refund requests, call askRefundAgent - never answer those yourself. ' +
+    'When the customer does not repeat the order id, use the one they gave earlier in the conversation when asking the order or refund desk.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
