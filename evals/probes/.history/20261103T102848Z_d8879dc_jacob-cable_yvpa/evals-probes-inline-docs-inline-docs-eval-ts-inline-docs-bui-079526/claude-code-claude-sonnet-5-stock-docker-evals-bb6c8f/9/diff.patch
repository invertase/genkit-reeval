diff --git a/src/agents.ts b/src/agents.ts
index 42df985..7cf2d0e 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,50 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description:
+      'Hands an order question (status, delivery, tracking or total) to the order desk. ' +
+      'Include the order id if the customer has given one, even if they gave it earlier in the conversation.',
+    inputSchema: z.object({ question: z.string(), orderId: z.string().optional() }),
+    outputSchema: z.object({ answer: z.string() }),
+  },
+  async ({ question, orderId }) => {
+    const message = orderId ? `${question} (order ${orderId})` : question;
+    const { text } = await orderAgent.chat().send(message);
+    return { answer: text };
+  },
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description:
+      'Hands a refund request to the refund desk. ' +
+      'Include the order id if the customer has given one, even if they gave it earlier in the conversation.',
+    inputSchema: z.object({ request: z.string(), orderId: z.string().optional() }),
+    outputSchema: z.object({ answer: z.string() }),
+  },
+  async ({ request, orderId }) => {
+    const message = orderId ? `${request} (order ${orderId})` : request;
+    const { text } = await refundAgent.chat().send(message);
+    return { answer: text };
+  },
+);
+
+/** Front desk agent customers talk to first; routes order questions and refund requests instead of answering them. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Greets customers and routes their request to the right desk.',
+  system:
+    'You are the Northwind Supplies front desk. You never answer order or refund questions yourself. ' +
+    'For order questions (status, delivery, tracking, total) call askOrderAgent. ' +
+    'For refund requests call askRefundAgent. ' +
+    'Remember any order id the customer mentioned earlier in the conversation and pass it to these tools ' +
+    'even when the customer does not repeat it.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
