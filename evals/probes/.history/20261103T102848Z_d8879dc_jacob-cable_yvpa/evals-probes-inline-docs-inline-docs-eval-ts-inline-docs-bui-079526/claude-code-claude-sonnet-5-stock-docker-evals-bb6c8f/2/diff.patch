+
+const transferToOrderAgent = ai.defineTool(
+  {
+    name: 'transferToOrderAgent',
+    description:
+      'Hands an order question (status, delivery date, tracking code or total) to the order desk. ' +
+      'Pass the customer\'s question, including any order id or other relevant detail already given earlier in the conversation.',
+    inputSchema: z.object({ message: z.string().describe("The customer's question, with any order id already known included") }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => {
+    const { text } = await orderAgent.chat().send(message);
+    return text;
+  },
+);
+
+const transferToRefundAgent = ai.defineTool(
+  {
+    name: 'transferToRefundAgent',
+    description:
+      'Hands a refund request to the refund desk. ' +
+      'Pass the customer\'s request, including any order id or other relevant detail already given earlier in the conversation.',
+    inputSchema: z.object({ message: z.string().describe("The customer's refund request, with any order id already known included") }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => {
+    const { text } = await refundAgent.chat().send(message);
+    return text;
+  },
+);
+
+/** The front desk customers talk to first; routes order questions and refund requests to the right specialist. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Northwind Supplies front desk. Greets the customer and routes their request to the right specialist.',
+  system:
+    'You are the Northwind Supplies front desk. Figure out what the customer needs, but never answer order or refund ' +
+    'questions yourself. For questions about an order\'s status, delivery date, tracking code or total, call ' +
+    'transferToOrderAgent. For refund requests, call transferToRefundAgent. ' +
+    'When you hand off, include any order id or other detail the customer already gave earlier in the conversation, ' +
+    'since the specialist does not see that history.',
+  tools: [transferToOrderAgent, transferToRefundAgent],
+  maxTurns: 4,
+  store,
+});
