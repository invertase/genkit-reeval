--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,49 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderDesk = ai.defineTool(
+  {
+    name: 'askOrderDesk',
+    description: 'Hands an order question (status, delivery, tracking or total) to the order desk and returns its reply.',
+    inputSchema: z.object({
+      message: z.string().describe('The order question, self-contained with the order id and any detail the order desk needs.'),
+    }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => {
+    const { text } = await orderAgent.chat().send(message);
+    return text;
+  },
+);
+
+const askRefundDesk = ai.defineTool(
+  {
+    name: 'askRefundDesk',
+    description: 'Hands a refund request to the refund desk and returns its reply.',
+    inputSchema: z.object({
+      message: z.string().describe('The refund request, self-contained with the order id and any detail the refund desk needs.'),
+    }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => {
+    const { text } = await refundAgent.chat().send(message);
+    return text || 'Your refund request is being reviewed and needs human approval before it can be issued.';
+  },
+);
+
+/** The front desk customers talk to first; it hands off order and refund questions instead of answering them itself. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'The Northwind Supplies front desk. Greets customers and routes them to the right specialist.',
+  system:
+    'You are the Northwind Supplies front desk. You never answer order or refund questions yourself. ' +
+    'For order status, delivery, tracking or total questions, call askOrderDesk. ' +
+    'For refund requests, call askRefundDesk. ' +
+    'When you call a tool, write a self-contained message for it: include the order id and any other detail ' +
+    'the customer gave earlier in the conversation, even if they do not repeat it now. ' +
+    'Relay the specialist reply back to the customer.',
+  tools: [askOrderDesk, askRefundDesk],
+  maxTurns: 6,
+  store,
+});
