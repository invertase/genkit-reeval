 });
+
+const transferToOrderAgent = ai.defineTool(
+  {
+    name: 'transferToOrderAgent',
+    description:
+      'Hands an order question (status, delivery date, tracking code or total) to the order desk. ' +
+      'Pass a self-contained request, including the order id when the customer has given one earlier in the conversation.',
+    inputSchema: z.object({
+      request: z.string().describe('What the customer wants to know, including the order id if it is known.'),
+    }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await orderAgent.chat().send(request);
+    return response.text;
+  },
+);
+
+const transferToRefundAgent = ai.defineTool(
+  {
+    name: 'transferToRefundAgent',
+    description:
+      'Hands a refund request to the refund desk. Pass a self-contained request, including the order id when ' +
+      'the customer has given one earlier in the conversation.',
+    inputSchema: z.object({
+      request: z.string().describe('What refund the customer wants, including the order id if it is known.'),
+    }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    return response.text;
+  },
+);
+
+/** The front desk agent customers talk to first; routes to the order desk or refund desk instead of answering itself. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'The Northwind Supplies front desk. Figures out what the customer needs and routes them to the right specialist.',
+  system:
+    'You are the Northwind Supplies front desk. You never answer order or refund questions yourself. ' +
+    'Hand order questions (status, delivery date, tracking, total) to transferToOrderAgent, and refund requests to transferToRefundAgent. ' +
+    'When you call either tool, pass a self-contained request that includes the order id whenever the customer mentioned one earlier in the conversation. ' +
+    'Relay the specialist\'s answer back to the customer in your own reply.',
+  tools: [transferToOrderAgent, transferToRefundAgent],
+  maxTurns: 4,
+  store,
+});
