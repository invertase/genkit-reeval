+/** Lets the CLI exercise a two-turn triage conversation in one shot. */
+export const tryTriageTwoTurn = ai.defineFlow(
+  {
+    name: 'tryTriageTwoTurn',
+    inputSchema: z.object({ turn1: z.string(), turn2: z.string() }),
+    outputSchema: z.object({ turn1: z.string(), turn2: z.string() }),
+  },
+  async ({ turn1, turn2 }) => {
+    const chat = triage.chat();
+    const res1 = await chat.send(turn1);
+    const res2 = await chat.send(turn2);
+    return { turn1: res1.text, turn2: res2.text };
+  },
+);
+
