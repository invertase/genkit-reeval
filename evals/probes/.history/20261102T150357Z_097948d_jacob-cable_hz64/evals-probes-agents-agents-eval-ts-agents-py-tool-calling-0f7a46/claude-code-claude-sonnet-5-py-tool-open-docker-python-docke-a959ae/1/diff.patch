+import json
+from pathlib import Path
+
+from pydantic import BaseModel
+
+from genkit._ai._aio import Genkit
+from genkit_google_genai import GoogleAI
+
+ORDERS_PATH = Path(__file__).parent / 'orders.json'
+
+ai = Genkit(plugins=[GoogleAI()], model=GoogleAI.gemini_model('gemini-flash-latest'))
+
+
+class OrderLookupInput(BaseModel):
+    order_id: str
+
+
+@ai.tool()
+async def lookup_order_status(input: OrderLookupInput) -> dict:
+    """Look up the status and ETA of an order by its order id."""
+    orders = json.loads(ORDERS_PATH.read_text())
+    order = orders.get(input.order_id)
+    if order is None:
+        return {'error': f'No order found with id {input.order_id}'}
+    return order
+
+
+async def ask(question: str) -> str:
+    response = await ai.generate(prompt=question, tools=['lookup_order_status'])
+    return response.text
