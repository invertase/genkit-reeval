+import json
+from pathlib import Path
+
+from genkit import Genkit
+from genkit_google_genai import GoogleAI
+from pydantic import BaseModel
+
+ORDERS_PATH = Path(__file__).parent / "orders.json"
+
+ai = Genkit(plugins=[GoogleAI()])
+
+
+class OrderLookupInput(BaseModel):
+    order_id: str
+
+
+@ai.tool()
+async def lookup_order_status(input: OrderLookupInput) -> str:
+    """Look up the status and ETA of an order by its id."""
+    orders = json.loads(ORDERS_PATH.read_text())
+    order = orders.get(input.order_id)
+    if order is None:
+        return f"No order found with id {input.order_id}."
+    return json.dumps({"order_id": input.order_id, **order})
+
+
+async def ask(question: str) -> str:
+    res = await ai.generate(
+        model=GoogleAI.gemini_model("gemini-flash-latest"),
+        prompt=question,
+        tools=["lookup_order_status"],
+    )
+    return res.text
