+const sessionsDir = join(dirname(fileURLToPath(import.meta.url)), '..', '.sessions')
+
+function sessionPath(sessionId: string): string {
+  return join(sessionsDir, `${sessionId}.json`)
+}
+
+async function loadHistory(sessionId: string): Promise<MessageData[]> {
+  try {
+    const history: MessageData[] = JSON.parse(await readFile(sessionPath(sessionId), 'utf-8'))
+    return history.filter((m) => m.role !== 'system')
+  } catch {
+    return []
+  }
+}
+
+async function saveHistory(sessionId: string, history: MessageData[]): Promise<void> {
+  await mkdir(sessionsDir, { recursive: true })
+  await writeFile(sessionPath(sessionId), JSON.stringify(history))
+}
+
+/** Answers a message, continuing the conversation identified by sessionId (or starting a new one if undefined). */
+export async function turn(sessionId: string | undefined, message: string): Promise<{ reply: string; sessionId: string }> {
+  const id = sessionId ?? randomUUID()
+  const history = await loadHistory(id)
+
+  const { text, messages } = await ai.generate({
+    system: 'You are a helpful assistant. Answer briefly.',
+    messages: history,
+    prompt: message,
+  })
+
+  await saveHistory(id, messages)
+  return { reply: text, sessionId: id }
 }
