+/** Continues the conversation identified by sessionId, or starts a new one when sessionId is undefined. */
+export async function turn(sessionId: string | undefined, message: string): Promise<{ reply: string; sessionId: string }> {
+  const chat = assistant.chat(sessionId ? { sessionId } : {})
+  const { text } = await chat.send(message)
