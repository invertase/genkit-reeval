-export {}
+import { googleAI } from '@genkit-ai/google-genai';
+import { genkit } from 'genkit';
+
+const ai = genkit({
+  plugins: [googleAI()],
+});
+
+const PRIMARY_MODEL = googleAI.model('gemini-flash-latest');
+const FALLBACK_MODEL = googleAI.model('gemini-pro-latest');
+
+const JOKE_PROMPT = 'Tell me a short, original joke. Reply with only the joke.';
+
+const jokeFlow = ai.defineFlow({ name: 'jokeFlow' }, async () => {
+  try {
+    const { text } = await ai.generate({
+      model: PRIMARY_MODEL,
+      prompt: JOKE_PROMPT,
+    });
+    return text;
+  } catch (err) {
+    console.error('Primary model failed, falling back:', err);
+    const { text } = await ai.generate({
+      model: FALLBACK_MODEL,
+      prompt: JOKE_PROMPT,
+    });
+    return text;
+  }
+});
+
+const joke = await jokeFlow();
+console.log(joke);
