+import { googleAI } from '@genkit-ai/google-genai';
+import { genkit, z } from 'genkit';
+
+const ai = genkit({
+  plugins: [googleAI()],
+  model: googleAI.model('gemini-flash-latest'),
+});
+
+const ContactSchema = z.object({
+  name: z.string().describe("The sender's name."),
+  email: z.string().describe("The sender's email address."),
+});
+
+export const extractContact = ai.defineFlow(
+  {
+    name: 'extractContact',
+    inputSchema: z.string(),
+    outputSchema: ContactSchema,
+  },
+  async (message) => {
+    const { output } = await ai.generate({
+      prompt: `Extract the sender's name and email from this message:\n\n${message}`,
+      output: { schema: ContactSchema },
+    });
+
+    if (!output) {
+      throw new Error('Failed to extract contact information from message.');
+    }
+
+    return output;
+  },
+);
