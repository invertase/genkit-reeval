+import { genkit, z } from "genkit";
+import { anthropic, claude45Opus } from "genkitx-anthropic";
+
+const ai = genkit({
+  plugins: [anthropic({ apiKey: process.env.ANTHROPIC_API_KEY })],
+});
+
+export const askClaude = ai.defineFlow(
+  {
+    name: "askClaude",
+    inputSchema: z.string(),
+    outputSchema: z.string(),
+  },
+  async (question) => {
+    const { text } = await ai.generate({
+      model: claude45Opus,
+      prompt: question,
+    });
+    return text;
+  },
+);
