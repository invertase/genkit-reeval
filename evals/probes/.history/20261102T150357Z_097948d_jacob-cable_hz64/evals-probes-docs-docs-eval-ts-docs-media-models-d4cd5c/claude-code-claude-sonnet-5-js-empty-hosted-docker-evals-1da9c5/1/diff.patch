+import { genkit, z } from 'genkit';
+import { googleAI } from '@genkit-ai/google-genai';
+
+const ai = genkit({
+  plugins: [googleAI()],
+});
+
+export const speak = ai.defineFlow(
+  {
+    name: 'speak',
+    inputSchema: z.object({ text: z.string() }),
+    outputSchema: z.object({ audioUrl: z.string() }),
+  },
+  async ({ text }) => {
+    const response = await ai.generate({
+      model: googleAI.model('gemini-3.8-flash-tts'),
+      config: {
+        speechConfig: {
+          voiceConfig: {
+            prebuiltVoiceConfig: { voiceName: 'Algenib' },
+          },
+        },
+      },
+      prompt: text,
+    });
+
+    if (!response.media?.url) {
+      throw new Error('No audio was generated.');
+    }
+
+    return { audioUrl: response.media.url };
+  },
+);
+
+export const drawImage = ai.defineFlow(
+  {
+    name: 'drawImage',
+    inputSchema: z.object({ description: z.string() }),
+    outputSchema: z.object({ imageUrl: z.string() }),
+  },
+  async ({ description }) => {
+    const response = await ai.generate({
+      model: googleAI.model('gemini-nano-banana-2.1'),
+      prompt: description,
+    });
+
+    if (!response.media?.url) {
+      throw new Error('No image was generated.');
+    }
+
+    return { imageUrl: response.media.url };
+  },
+);
