+const TicketSummary2Schema = z.object({
+  summary: z.string().describe('One or two sentence summary of the ticket'),
+  priority: z.enum(['low', 'medium', 'high']).describe('How urgent the ticket is'),
+});
+
+/** Summarizes a raw support ticket into a short summary and a priority. */
+export const summarizeTicket2 = ai.defineFlow(
+  { name: 'summarizeTicket2', inputSchema: z.object({ text: z.string() }), outputSchema: TicketSummary2Schema },
+  async ({ text }) => {
+    const { output } = await ai.generate({
+      system:
+        'You triage support tickets for Northwind Supplies, an office supplies retailer. ' +
+        'Set priority to low, medium or high, where high means the customer is blocked.',
+      prompt: text,
+      output: { schema: TicketSummary2Schema },
+    });
+    if (!output) throw new Error('summarizeTicket2: model returned no structured output');
+    return output;
+  },
+);
