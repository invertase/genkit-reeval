diff --git a/src/agents.ts b/src/agents.ts
index 42df985..f8bca48 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,50 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderDesk = ai.defineTool(
+  {
+    name: 'askOrderDesk',
+    description: 'Hands an order question (status, delivery date, tracking code) to the order desk agent and returns its reply. Put the order id in the question.',
+    inputSchema: z.object({ question: z.string() }),
+    outputSchema: z.object({ reply: z.string() }),
+  },
+  async ({ question }) => ({ reply: (await orderAgent.chat().send(question)).text }),
+);
+
+const askRefundDesk = ai.defineTool(
+  {
+    name: 'askRefundDesk',
+    description: 'Hands a refund request to the refund desk agent and returns its reply. Put the order id and the reason in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.object({ reply: z.string(), finishReason: z.string() }),
+  },
+  async ({ request }) => {
+    const res = await refundAgent.chat().send(request);
+    return { reply: res.text, finishReason: res.finishReason };
+  },
+);
+
+/** Routes each customer message to the right specialist agent. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  system:
+    'Delegate order questions to orderAgent and refund requests to refundAgent. Do not answer them yourself. ' +
+    'Always put the order id in the delegated task; when the customer does not name an order, use the order id from earlier in the conversation.',
+  store,
+  maxTurns: 5,
+  toolChoice: 'auto',
+  tools: [askOrderDesk, askRefundDesk],
+});
+
+/** Lets the CLI exercise triage: `genkit flow:run` runs flows, not agents. */
+export const tryTriage = ai.defineFlow(
+  { name: 'tryTriage', inputSchema: z.string(), outputSchema: z.string() },
+  async (message) => (await triage.chat().send(message)).text,
+);
+
+/** Lets the CLI exercise the refund desk: `genkit flow:run` runs flows, not agents. */
+export const tryRefundDesk = ai.defineFlow(
+  { name: 'tryRefundDesk', inputSchema: z.string(), outputSchema: z.string() },
+  async (message) => (await refundAgent.chat().send(message)).text,
+);
