diff --git a/src/agents.ts b/src/agents.ts
index 42df985..558425d 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,40 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const handOffToOrderAgent = ai.defineTool(
+  {
+    name: 'handOffToOrderAgent',
+    description: 'Hands an order question to the order desk, which answers it. Pass the full question, including the order id.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const handOffToRefundAgent = ai.defineTool(
+  {
+    name: 'handOffToRefundAgent',
+    description: 'Hands a refund request to the refund desk. Pass the full request, including the order id.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.interrupts.length > 0) return 'The refund is waiting for human approval and has not been issued.';
+    return response.text;
+  },
+);
+
+/** Front desk: answers general questions and hands orders and refunds to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies customers. Hands order questions and refund requests to specialist agents.',
+  system:
+    'You are the Northwind Supplies front desk. Greet customers and answer general questions yourself. ' +
+    'For questions about an order, call handOffToOrderAgent. For refund requests, call handOffToRefundAgent. ' +
+    'Never answer order or refund questions yourself. Pass the full question to the tool, including any order id the customer gave earlier in the conversation.',
+  tools: [handOffToOrderAgent, handOffToRefundAgent],
+  maxTurns: 4,
+  store,
+});
