diff --git a/src/agents.ts b/src/agents.ts
index 42df985..4603695 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,59 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const TriageStateSchema = z.object({
+  orderSessionId: z.string().optional(),
+  refundSessionId: z.string().optional(),
+});
+type TriageState = z.infer<typeof TriageStateSchema>;
+
+const askOrderDesk = ai.defineTool(
+  {
+    name: 'askOrderDesk',
+    description: 'Passes the customer\'s order question to the order desk and returns its answer.',
+    inputSchema: z.object({ message: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => {
+    const session = ai.currentSession<TriageState>();
+    const sessionId = session.getCustom()?.orderSessionId;
+    const chat = sessionId ? await orderAgent.loadChat({ sessionId }) : orderAgent.chat();
+    const response = await chat.send(message);
+    session.updateCustom((custom) => ({ ...custom, orderSessionId: response.sessionId }));
+    return response.text;
+  },
+);
+
+const askRefundDesk = ai.defineTool(
+  {
+    name: 'askRefundDesk',
+    description: 'Passes the customer\'s refund request to the refund desk and returns its reply.',
+    inputSchema: z.object({ message: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => {
+    const session = ai.currentSession<TriageState>();
+    const sessionId = session.getCustom()?.refundSessionId;
+    const chat = sessionId ? await refundAgent.loadChat({ sessionId }) : refundAgent.chat();
+    const response = await chat.send(message);
+    session.updateCustom((custom) => ({ ...custom, refundSessionId: response.sessionId }));
+    if (response.interrupts.length > 0) return 'Your refund request is waiting for approval from our team.';
+    return response.text;
+  },
+);
+
+/** Front desk: the first agent a customer talks to; hands order and refund requests to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies customers. Routes order and refund requests to the right desk.',
+  system:
+    'You are the front desk of the Northwind Supplies support team. Greet the customer and find out what they need. ' +
+    'For questions about an order, such as status, delivery or tracking, call askOrderDesk. ' +
+    'For refund requests, call askRefundDesk. Do not answer order or refund questions yourself. ' +
+    'Pass the customer\'s words to the desk, including any order id they gave. Keep replies to one or two sentences.',
+  tools: [askOrderDesk, askRefundDesk],
+  stateSchema: TriageStateSchema,
+  maxTurns: 4,
+  store,
+});
