diff --git a/src/agents.ts b/src/agents.ts
index 42df985..1dd2ba0 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,46 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const handOffToOrderAgent = ai.defineTool(
+  {
+    name: 'handOffToOrderAgent',
+    description:
+      'Hands an order question (status, delivery, tracking, total) to the order desk and returns its answer. ' +
+      'The desk cannot see this conversation, so include any order id the customer gave earlier.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const handOffToRefundAgent = ai.defineTool(
+  {
+    name: 'handOffToRefundAgent',
+    description:
+      'Hands a refund request to the refund desk and returns its answer. ' +
+      'The desk cannot see this conversation, so include the order id and the customer\'s reason.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.interrupts.length > 0) {
+      return 'The refund is waiting for human approval and has not been issued yet.';
+    }
+    return response.text;
+  },
+);
+
+/** Front desk: routes each customer message to the order or refund desk. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Routes order and refund questions to the right desk.',
+  system:
+    'You are the front desk of Northwind Supplies. Route order and refund requests; do not answer them yourself. ' +
+    'For questions about an order, call handOffToOrderAgent. For refund requests, call handOffToRefundAgent. ' +
+    'Reply to the customer with the desk\'s answer. For anything else, reply in one sentence and ask what they need.',
+  tools: [handOffToOrderAgent, handOffToRefundAgent],
+  maxTurns: 4,
+  store,
+});
