diff --git a/src/agents.ts b/src/agents.ts
index 42df985..e2045e7 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,42 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description: 'Hands an order question to the order desk. Pass the order id and every detail the customer gave.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description: 'Hands a refund request to the refund desk. Pass the order id and every detail the customer gave.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.interrupts.length > 0) return 'The refund request is waiting for human approval.';
+    return response.text;
+  },
+);
+
+/** Front desk: the first agent a customer talks to. Hands orders and refunds to specialists. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Routes order and refund questions to specialists.',
+  system:
+    'You are the Northwind Supplies front desk. Greet the customer and find out what they need. ' +
+    'For questions about an order, its status, delivery, tracking or total, call askOrderAgent. ' +
+    'For refund requests, call askRefundAgent. Never answer order or refund questions yourself. ' +
+    'The specialists do not see this conversation, so each request must include the order id and details the customer gave, including ones from earlier messages. ' +
+    'Reply to the customer in one or two sentences with the specialist answer.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
