diff --git a/src/agents.ts b/src/agents.ts
index 42df985..3bcefe1 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,48 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderDesk = ai.defineTool(
+  {
+    name: 'askOrderDesk',
+    description:
+      'Hands an order question to the order desk, which answers from the order records. ' +
+      'Pass the order id (for example A-1001) and the full question in the message, because the desk does not see this conversation.',
+    inputSchema: z.object({ message: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => (await orderAgent.chat().send(message)).text,
+);
+
+const askRefundDesk = ai.defineTool(
+  {
+    name: 'askRefundDesk',
+    description:
+      "Hands a refund request to the refund desk. Pass the order id (for example A-1001) and the customer's request in the message, " +
+      'because the desk does not see this conversation.',
+    inputSchema: z.object({ message: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ message }) => {
+    const response = await refundAgent.chat().send(message);
+    if (response.interrupts.length > 0) {
+      return 'The refund is waiting for human approval and has not been issued yet.';
+    }
+    return response.text;
+  },
+);
+
+/** The front desk customers talk to first; hands order and refund questions to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Routes order questions and refund requests to the right desk.',
+  system:
+    'You are the Northwind Supplies front desk. Greet the customer and find out what they need. ' +
+    'Order status questions go to askOrderDesk. Refund requests go to askRefundDesk. ' +
+    'Do not look up orders or answer order or refund questions yourself. ' +
+    'When you hand off, include the order id the customer gave, copied from the conversation, and their full request. ' +
+    'Pass the desk\'s answer on to the customer with its details unchanged.',
+  tools: [askOrderDesk, askRefundDesk],
+  maxTurns: 4,
+  store,
+});
