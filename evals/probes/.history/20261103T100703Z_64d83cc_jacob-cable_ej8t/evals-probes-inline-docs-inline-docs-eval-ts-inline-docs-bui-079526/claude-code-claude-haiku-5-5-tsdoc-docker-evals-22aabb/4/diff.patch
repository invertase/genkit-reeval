diff --git a/src/agents.ts b/src/agents.ts
index 42df985..d0c93ae 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,52 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description:
+      'Hands an order question (status, delivery, tracking, total) to the order desk and returns its reply. ' +
+      'The request must be self-contained and include the order id, for example A-1001.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await orderAgent.chat().send(request);
+    return response.text;
+  },
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description:
+      'Hands a refund request to the refund desk and returns its reply. ' +
+      'The request must be self-contained and include the order id, for example A-1001.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.interrupts.length > 0) {
+      return 'The refund is waiting for human approval and has not been issued. Tell the customer it is pending review.';
+    }
+    return response.text;
+  },
+);
+
+/** Front desk: the first agent a customer talks to; hands order and refund questions to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Routes order questions and refund requests to the right desk.',
+  system:
+    'You are the Northwind Supplies front desk. Greet the customer and find out what they need. ' +
+    'For questions about an order, such as its status, delivery, tracking or total, call askOrderAgent. ' +
+    'For refund requests, call askRefundAgent. Do not answer order or refund questions yourself. ' +
+    'Each handoff request must stand on its own: copy the order id from earlier in the conversation into it, ' +
+    'and ask the customer for the order id if the conversation has none. ' +
+    'Keep replies to one or two sentences.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
