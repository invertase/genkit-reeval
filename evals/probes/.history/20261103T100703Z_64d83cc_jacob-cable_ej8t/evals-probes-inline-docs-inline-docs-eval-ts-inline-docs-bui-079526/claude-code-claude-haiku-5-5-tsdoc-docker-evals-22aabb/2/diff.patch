diff --git a/src/agents.ts b/src/agents.ts
index 42df985..6407cc7 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,42 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const consultOrderAgent = ai.defineTool(
+  {
+    name: 'consultOrderAgent',
+    description: 'Passes an order question to the order desk and returns its answer. Include the order id in the request.',
+    inputSchema: z.object({ request: z.string().describe('The customer question, with the order id, for example A-1001') }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const consultRefundAgent = ai.defineTool(
+  {
+    name: 'consultRefundAgent',
+    description: 'Passes a refund request to the refund desk and returns its answer. Include the order id in the request.',
+    inputSchema: z.object({ request: z.string().describe('The refund request, with the order id, for example A-1001') }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    return response.interrupts.length > 0
+      ? 'The refund is waiting for human approval and has not been issued.'
+      : response.text;
+  },
+);
+
+/** Front desk: answers small talk itself and hands order and refund questions to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'The Northwind Supplies front desk. Start here for any customer request.',
+  system:
+    'You are the Northwind Supplies front desk. Do not answer order or refund questions yourself. ' +
+    'Send order questions (status, delivery, tracking, total) to consultOrderAgent and refund requests to consultRefundAgent. ' +
+    'Each request you send is the only context the specialist gets, so include the order id, taken from anything the customer said earlier in this conversation. ' +
+    'Relay the specialist answer to the customer in one or two sentences. Ask for an order id only when the conversation has none.',
+  tools: [consultOrderAgent, consultRefundAgent],
+  maxTurns: 4,
+  store,
+});
