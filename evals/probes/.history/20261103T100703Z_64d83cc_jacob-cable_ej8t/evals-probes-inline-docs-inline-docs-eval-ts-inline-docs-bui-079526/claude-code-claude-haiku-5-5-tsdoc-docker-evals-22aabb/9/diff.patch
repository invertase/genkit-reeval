diff --git a/src/agents.ts b/src/agents.ts
index 42df985..555ac8a 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,46 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderDesk = ai.defineTool(
+  {
+    name: 'askOrderDesk',
+    description:
+      'Hands an order question (status, delivery date, tracking code, total) to the order desk and returns its answer. ' +
+      'Include the order id in the request when the customer gave one earlier.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundDesk = ai.defineTool(
+  {
+    name: 'askRefundDesk',
+    description:
+      'Hands a refund request to the refund desk and returns its answer. ' +
+      'Include the order id in the request when the customer gave one earlier.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.interrupts.length > 0) {
+      return `${response.text} The refund is waiting for human approval and has not been issued.`.trim();
+    }
+    return response.text;
+  },
+);
+
+/** Customer-facing front desk that answers simple questions itself and hands order and refund requests to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Routes order questions and refund requests to the right desk.',
+  system:
+    'You are the Northwind Supplies front desk. Greet customers and answer general questions yourself. ' +
+    'Hand order questions to askOrderDesk and refund requests to askRefundDesk; never answer those yourself. ' +
+    'Put any order id the customer gave earlier in the conversation into the request. Keep replies to one or two sentences.',
+  tools: [askOrderDesk, askRefundDesk],
+  maxTurns: 4,
+  store,
+});
