 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description: 'Hands an order question to the order desk. Include the order id in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.object({ reply: z.string() }),
+  },
+  async ({ request }) => ({ reply: (await orderAgent.chat().send(request)).text }),
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description: 'Hands a refund request to the refund desk. Include the order id in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.object({ reply: z.string() }),
+  },
+  async ({ request }) => ({ reply: (await refundAgent.chat().send(request)).text }),
+);
+
+/** Front desk: the first agent customers talk to. Hands order and refund questions to specialists. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Routes order and refund questions to specialist agents.',
+  system:
+    'You are the Northwind Supplies front desk. Greet customers and handle general questions briefly yourself. ' +
+    'For questions about an order (status, delivery, tracking, total) call askOrderAgent. ' +
+    'For refund requests call askRefundAgent. Never answer order or refund questions yourself. ' +
+    'Specialists do not see this conversation, so put the order id from earlier in the conversation into every request. ' +
+    'If the customer has not given an order id, ask for one before handing off.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
