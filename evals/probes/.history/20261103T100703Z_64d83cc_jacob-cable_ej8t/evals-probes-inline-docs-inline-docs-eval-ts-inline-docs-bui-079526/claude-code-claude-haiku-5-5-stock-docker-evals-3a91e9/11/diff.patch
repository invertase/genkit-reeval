diff --git a/src/agents.ts b/src/agents.ts
index 42df985..7604fd0 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,50 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description:
+      'Hands an order question to the order desk. The desk cannot see the conversation, so include the order id and any details the customer gave.',
+    inputSchema: z.object({ question: z.string() }),
+    outputSchema: z.object({ answer: z.string() }),
+  },
+  async ({ question }) => {
+    const response = await orderAgent.chat().send(question);
+    return { answer: response.text };
+  },
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description:
+      'Hands a refund request to the refund desk. The desk cannot see the conversation, so include the order id and the customer reason.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.object({ answer: z.string() }),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.interrupts.length > 0) {
+      return { answer: `The refund is waiting for human approval (refund session ${response.sessionId}).` };
+    }
+    return { answer: response.text };
+  },
+);
+
+/** Front desk: the first agent customers talk to. Routes order and refund questions to the desks. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Routes order questions and refund requests to the right desk.',
+  system:
+    'You are the Northwind Supplies front desk. Greet customers and handle general chat yourself. ' +
+    'For any question about an order, call askOrderAgent. For any refund request, call askRefundAgent. ' +
+    'Never answer order status or refund questions yourself. ' +
+    'The desks cannot see this conversation, so put the order id and the details the customer gave into the question you hand off. ' +
+    'When the customer asks about an order they named earlier, use that order id. ' +
+    'Reply to the customer with the desk answer, keeping it short.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
