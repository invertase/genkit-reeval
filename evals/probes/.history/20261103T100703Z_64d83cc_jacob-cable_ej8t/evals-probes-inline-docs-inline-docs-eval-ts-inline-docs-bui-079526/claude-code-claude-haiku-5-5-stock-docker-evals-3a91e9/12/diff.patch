+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description: 'Hands an order question to the order desk and returns its answer.',
+    inputSchema: z.object({ request: z.string().describe('The customer question, including any order id they gave') }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description: 'Hands a refund request to the refund desk and returns its answer.',
+    inputSchema: z.object({ request: z.string().describe('The refund request, including the order id the customer gave') }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await refundAgent.chat().send(request)).text,
+);
+
+/** Front desk agent: the first agent customers talk to. Routes order and refund requests to the specialists. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk agent. Answers general questions and hands order and refund requests to specialists.',
+  system:
+    'You are the Northwind Supplies front desk. Do not answer order status or refund questions yourself: ' +
+    'send order questions to askOrderAgent and refund requests to askRefundAgent. ' +
+    'The specialists only see the request you pass them, so include the order id from earlier in the conversation when the customer does not repeat it. ' +
+    'Answer greetings and general questions briefly yourself.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
