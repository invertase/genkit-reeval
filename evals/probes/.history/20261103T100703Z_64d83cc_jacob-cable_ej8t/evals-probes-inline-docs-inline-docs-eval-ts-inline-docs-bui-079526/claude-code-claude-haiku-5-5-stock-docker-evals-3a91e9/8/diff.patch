diff --git a/src/agents.ts b/src/agents.ts
index 42df985..3a39b46 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,39 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderDesk = ai.defineTool(
+  {
+    name: 'askOrderDesk',
+    description: 'Hands an order question to the order desk and returns its answer. Include the order id, for example A-1001, from the conversation.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundDesk = ai.defineTool(
+  {
+    name: 'askRefundDesk',
+    description: 'Hands a refund request to the refund desk and returns its answer. Include the order id, for example A-1001, from the conversation.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    return response.interrupts.length > 0 ? 'The refund is waiting for human approval and has not been issued.' : response.text;
+  },
+);
+
+/** Front desk the customer talks to first; hands order and refund questions to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Northwind Supplies front desk. Routes order questions and refund requests to the right desk.',
+  system:
+    'You are the Northwind Supplies front desk. Never answer order status, delivery, tracking or refund questions yourself. ' +
+    'Send order questions to askOrderDesk and refund requests to askRefundDesk, and pass along the order id the customer gave earlier in the conversation. ' +
+    'Relay the answer from the desk to the customer in one or two sentences. Answer greetings and other small talk yourself.',
+  tools: [askOrderDesk, askRefundDesk],
+  maxTurns: 4,
+  store,
+});
