diff --git a/src/agents.ts b/src/agents.ts
index 42df985..4bbe4e0 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,48 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderDesk = ai.defineTool(
+  {
+    name: 'askOrderDesk',
+    description:
+      'Hands an order question (status, delivery, tracking, total) to the order desk and returns its answer. ' +
+      'Write a self-contained request that includes the order id, for example "What is the status of order A-1001?"',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await orderAgent.chat().send(request);
+    return response.text;
+  },
+);
+
+const askRefundDesk = ai.defineTool(
+  {
+    name: 'askRefundDesk',
+    description:
+      'Hands a refund request to the refund desk and returns its answer. ' +
+      'Write a self-contained request that includes the order id, for example "Refund order A-1001, the customer says it arrived damaged."',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.finishReason === 'interrupted') return 'The refund is waiting for approval from a human agent.';
+    return response.text;
+  },
+);
+
+/** The front desk: answers greetings itself and hands order and refund questions to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'The front desk. Customers start here; order and refund questions are handed to specialists.',
+  system:
+    'You are the Northwind Supplies front desk. Greet customers and answer general questions yourself. ' +
+    'Never answer order or refund questions yourself: pass them to askOrderDesk or askRefundDesk and relay the answer. ' +
+    'Those desks do not see this conversation, so each request must restate the order id the customer gave earlier. ' +
+    'If a customer asks about an order but has not given an order id, ask for one before handing off.',
+  tools: [askOrderDesk, askRefundDesk],
+  maxTurns: 6,
+  store,
+});
