diff --git a/src/agents.ts b/src/agents.ts
index 42df985..294351e 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,44 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderDesk = ai.defineTool(
+  {
+    name: 'askOrderDesk',
+    description:
+      'Hands an order question to the order desk. Include the order id, for example A-1001, from earlier in the conversation.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundDesk = ai.defineTool(
+  {
+    name: 'askRefundDesk',
+    description:
+      'Hands a refund request to the refund desk. Include the order id, for example A-1001, from earlier in the conversation. Refunds need human approval.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.interrupts.length > 0) return 'The refund is waiting for human approval and has not been issued.';
+    return response.text;
+  },
+);
+
+/** Front desk: the first agent a customer talks to. Hands order and refund questions to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies customers. Hands order and refund questions to specialist agents.',
+  system:
+    'You are the front desk of the Northwind Supplies support team. Greet customers and answer general questions yourself. ' +
+    'For anything about an order (status, delivery, tracking, total), call askOrderDesk. ' +
+    'For refunds, call askRefundDesk. Never answer order or refund questions yourself. ' +
+    'Put the order id the customer gave earlier in the conversation into the request you hand off. ' +
+    'Keep replies to one or two sentences.',
+  tools: [askOrderDesk, askRefundDesk],
+  maxTurns: 4,
+  store,
+});
