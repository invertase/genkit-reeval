diff --git a/src/agents.ts b/src/agents.ts
index 42df985..007437a 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,44 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description: 'Hands an order question to the order desk. Include the order id, for example A-1001, in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description: 'Hands a refund request to the refund desk. Include the order id, for example A-1001, in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    if (response.interrupts.length > 0) {
+      return `The refund is waiting for human approval in refund session ${response.sessionId}.`;
+    }
+    return response.text;
+  },
+);
+
+/** Front desk: the first agent customers talk to; routes order and refund questions to specialists. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Routes order and refund questions to the order and refund desks.',
+  system:
+    'You are the Northwind Supplies front desk. Greet customers and answer general questions yourself. ' +
+    'Never answer questions about an order or a refund yourself: for order status, delivery, tracking or totals call askOrderAgent, ' +
+    'and for refund requests call askRefundAgent. Put the order id in the request you pass on. ' +
+    'When the customer does not repeat the order id, use the one from earlier in the conversation; ask for one only when the conversation has none. ' +
+    'Keep replies to one or two sentences.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
