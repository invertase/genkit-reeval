diff --git a/src/agents.ts b/src/agents.ts
index 42df985..7443d24 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,40 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const askOrderAgent = ai.defineTool(
+  {
+    name: 'askOrderAgent',
+    description: 'Hands an order question to the order desk and returns its answer. Put the order id in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => (await orderAgent.chat().send(request)).text,
+);
+
+const askRefundAgent = ai.defineTool(
+  {
+    name: 'askRefundAgent',
+    description: 'Hands a refund request to the refund desk and returns its answer. Put the order id in the request.',
+    inputSchema: z.object({ request: z.string() }),
+    outputSchema: z.string(),
+  },
+  async ({ request }) => {
+    const response = await refundAgent.chat().send(request);
+    return response.interrupts.length > 0 ? 'This refund needs human approval before it can be issued.' : response.text;
+  },
+);
+
+/** Customer-facing front desk; hands order and refund questions to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'The first agent customers talk to. Hands order questions to orderAgent and refund requests to refundAgent.',
+  system:
+    'You are the Northwind Supplies front desk. Greet customers and handle general small talk yourself. ' +
+    'Never answer order status, delivery, tracking or refund questions yourself: call askOrderAgent for orders and askRefundAgent for refunds. ' +
+    'The specialists do not see this conversation, so each request must restate the order id and what the customer wants. ' +
+    'Remember order ids the customer gave earlier and use them when they ask follow-up questions.',
+  tools: [askOrderAgent, askRefundAgent],
+  maxTurns: 4,
+  store,
+});
