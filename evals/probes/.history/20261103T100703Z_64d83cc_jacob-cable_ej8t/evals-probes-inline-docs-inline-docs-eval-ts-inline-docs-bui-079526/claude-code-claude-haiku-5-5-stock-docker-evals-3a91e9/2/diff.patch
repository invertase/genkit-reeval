diff --git a/src/agents.ts b/src/agents.ts
index 42df985..4d48f8c 100644
--- a/src/agents.ts
+++ b/src/agents.ts
@@ -51,3 +51,60 @@ export const refundAgent = ai.defineAgent({
   maxTurns: 6,
   store,
 });
+
+const TriageStateSchema = z.object({
+  orderSessionId: z.string().optional(),
+  refundSessionId: z.string().optional(),
+});
+
+const handOff = (
+  name: string,
+  description: string,
+  key: keyof z.infer<typeof TriageStateSchema>,
+  agent: typeof orderAgent,
+) =>
+  ai.defineTool(
+    {
+      name,
+      description,
+      inputSchema: z.object({ request: z.string().describe('The customer request, including any order id they gave') }),
+      outputSchema: z.string(),
+    },
+    async ({ request }) => {
+      const session = ai.currentSession<z.infer<typeof TriageStateSchema>>();
+      const sessionId = session.getCustom()?.[key];
+      const chat = sessionId ? await agent.loadChat({ sessionId }) : agent.chat();
+      const response = await chat.send(request);
+      session.updateCustom((custom) => ({ ...custom, [key]: response.sessionId }));
+      return response.text;
+    },
+  );
+
+const transferToOrderAgent = handOff(
+  'transferToOrderAgent',
+  'Hands an order question (status, delivery date, tracking, total) to the order desk and returns its answer.',
+  'orderSessionId',
+  orderAgent,
+);
+
+const transferToRefundAgent = handOff(
+  'transferToRefundAgent',
+  'Hands a refund request to the refund desk and returns its reply.',
+  'refundSessionId',
+  refundAgent,
+);
+
+/** The front desk: the first agent customers talk to. Routes order and refund questions to the specialist agents. */
+export const triage = ai.defineAgent({
+  name: 'triage',
+  description: 'Front desk for Northwind Supplies. Greets customers and routes order and refund requests to specialists.',
+  system:
+    'You are the Northwind Supplies front desk. Greet customers and find out what they need. ' +
+    'Never answer order status, delivery, tracking or refund questions yourself: call transferToOrderAgent for orders ' +
+    'and transferToRefundAgent for refunds, and pass along the customer request with any order id they gave earlier in the conversation. ' +
+    'Give the specialist reply to the customer as it is. Keep your own replies to one or two sentences.',
+  tools: [transferToOrderAgent, transferToRefundAgent],
+  stateSchema: TriageStateSchema,
+  maxTurns: 4,
+  store,
+});
